ngBorder\",\"position\":[24,0.4,-0.5],\"size\":[28,0.2,0.6],\"color\":[247,203,92]},{\"name\":\"BagBase\",\"position\":[24,1,-14],\"size\":[10,1.4,10],\"color\":[57,67,77],\"shape\":\"Cylinder\"},{\"name\":\"BagStem\",\"position\":[24,6,-14],\"size\":[1,10,1],\"color\":[162,175,179]},{\"name\":\"PunchingBag\",\"position\":[24,12,-14],\"size\":[6,12,6],\"color\":[218,99,97],\"shape\":\"Cylinder\"},{\"name\":\"BagCap\",\"position\":[24,18.2,-14],\"size\":[6.2,0.5,6.2],\"color\":[57,67,77],\"shape\":\"Cylinder\"},{\"name\":\"ExpansionCornerX\",\"position\":[-39,0.2,13],\"size\":[4,0.2,0.5],\"color\":[63,166,156]},{\"name\":\"ExpansionCornerZ\",\"position\":[-39,0.2,13],\"size\":[0.5,0.2,4],\"color\":[63,166,156]},{\"name\":\"ExpansionCornerX\",\"position\":[-39,0.2,37],\"size\":[4,0.2,0.5],\"color\":[63,166,156]},{\"name\":\"ExpansionCornerZ\",\"position\":[-39,0.2,37],\"size\":[0.5,0.2,4],\"color\":[63,166,156]},{\"name\":\"ExpansionCornerX\",\"position\":[3,0.2,13],\"size\":[4,0.2,0.5],\"color\":[63,166,156]},{\"name\":\"ExpansionCornerZ\",\"position\":[3,0.2,13],\"size\":[0.5,0.2,4],\"color\":[63,166,156]},{\"name\":\"ExpansionCornerX\",\"position\":[3,0.2,37],\"size\":[4,0.2,0.5],\"color\":[63,166,156]},{\"name\":\"ExpansionCornerZ\",\"position\":[3,0.2,37],\"size\":[0.5,0.2,4],\"color\":[63,166,156]}]]==])\r\n"},{Parent="ReplicatedStorage.Shared",Name="KitchenLayout",Class="ModuleScript",Source="local Layout = {}\n\nfunction Layout.Build(plot)\n    local area = plot:FindFirstChild(\"BuildArea\")\n    assert(area and area:IsA(\"BasePart\"), \"Kitchen plot is missing BuildArea\")\n    local old = plot:FindFirstChild(\"StarterKitchen\")\n    if old then old:Destroy() end\n    local kitchen = Instance.new(\"Model\")\n    kitchen.Name = \"StarterKitchen\"\n    kitchen:SetAttribute(\"Stage\", 1)\n    local scale = area.Size.X / 90\n    local frame = area.CFrame * CFrame.new(0, area.Size.Y / 2, 0)\n    for _, info in ipairs(require(script.Parent.KitchenTemplate)) do\n        local p = Instance.new(\"Part\")\n        p.Name = info.name\n        p.Anchored = true\n        p.Material = Enum.Material.Plastic\n        p.Color = Color3.fromRGB(table.unpack(info.color))\n        p.CanCollide = not info.invisible\n        p.CanQuery = not info.invisible\n        p.CanTouch = false\n        p.Transparency = info.invisible and 1 or 0\n        local size = Vector3.new(table.unpack(info.size)) * scale\n        local cf = frame * CFrame.new(Vector3.new(table.unpack(info.position)) * scale)\n        if info.shape == \"Cylinder\" then\n            p.Shape = Enum.PartType.Cylinder\n            p.Size = Vector3.new(size.Y, size.X, size.Z)\n            p.CFrame = cf * CFrame.Angles(0, 0, math.pi / 2)\n        else\n            p.Size, p.CFrame = size, cf\n        end\n        for _, face in ipairs({\"Top\", \"Bottom\", \"Left\", \"Right\", \"Front\", \"Back\"}) do\n            p[face .. \"Surface\"] = Enum.SurfaceType.Studs\n        end\n        p.Parent = kitchen\n    end\n    kitchen.Parent = plot\n    for _, p in ipairs(plot:GetChildren()) do\n        if p:IsA(\"BasePart\") and (p.Name:find(\"Curb\") or p.Name == \"PlotNumber\") then\n            p.Color = Color3.fromRGB(63, 166, 156)\n        end\n    end\n    return kitchen\nend\n\nreturn Layout\n"},{Parent="ReplicatedStorage.Shared",Name="KitchenGuide",Class="ModuleScript",Source="local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal PathfindingService = game:GetService(\"PathfindingService\")\nlocal Guide = {}\n\nfunction Guide.Start()\n    local player = Players.LocalPlayer\n    local folder = Instance.new(\"Folder\")\n    folder.Name = \"PersonalKitchenArrow\"\n    folder.Parent = workspace\n    local pool, points = {}, {}\n    local lastTarget, computing, lastPath, lastDraw = nil, false, 0, 0\n    local function hide()\n        for _, p in ipairs(pool) do p.Transparency = 1 end\n    end\n    local function draw(index, cf, size)\n        local p = pool[index]\n        if not p then\n            p = Instance.new(\"Part\")\n            p.Name = \"Arrow\"\n            p.Anchored = true\n            p.CanCollide, p.CanTouch, p.CanQuery = false, false, false\n            p.Material = Enum.Material.Plastic\n            p.Color = Color3.fromRGB(255, 205, 48)\n            p.CastShadow = false\n            p.Parent = folder\n            pool[index] = p\n        end\n        p.Size, p.CFrame, p.Transparency = size, cf, 0\n    end\n    RunService.Heartbeat:Connect(function()\n        local target = player:GetAttribute(\"KitchenGuideTarget\")\n        local root = player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n        if not target or player:GetAttribute(\"KitchenVisited\") or not root then hide() return end\n        if target ~= lastTarget then points = {} lastTarget = target lastPath = 0 end\n        local now = os.clock()\n        if not computing and now - lastPath > 1 then\n            computing, lastPath = true, now\n            local start, requestedTarget, character = root.Position, target, player.Character\n            task.spawn(function()\n                local path = PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true})\n                local ok = pcall(function() path:ComputeAsync(start, requestedTarget) end)\n                computing = false\n                if player.Character ~= character or player:GetAttribute(\"KitchenGuideTarget\") ~= requestedTarget\n                    or player:GetAttribute(\"KitchenVisited\") then return end\n                points = {}\n                if ok and path.Status == Enum.PathStatus.Success then\n                    for _, waypoint in ipairs(path:GetWaypoints()) do table.insert(points, waypoint.Position) end\n                else\n                    points = {start, requestedTarget}\n                end\n            end)\n        end\n        if now - lastDraw < 0.1 then return end\n        lastDraw = now\n        hide()\n        local route = {root.Position}\n        local nearest, nearestDistance = 1, math.huge\n        for i, point in ipairs(points) do\n            local distance = (point - root.Position).Magnitude\n            if distance < nearestDistance then nearest, nearestDistance = i, distance end\n        end\n        for i = nearest + 1, #points do table.insert(route, points[i]) end\n        if #route == 1 then table.insert(route, target) end\n        local totalLength = 0\n        for i = 1, #route - 1 do totalLength += (route[i + 1] - route[i]).Magnitude end\n        local spacing = math.max(4, totalLength / 110)\n        local count, carry = 0, 1\n        for i = 1, #route - 1 do\n            local a, b = route[i], route[i + 1]\n            local direction = Vector3.new(b.X - a.X, 0, b.Z - a.Z)\n            local length = direction.Magnitude\n            if length < 0.01 then continue end\n            local distance = carry\n            while distance <= length and count < 360 do\n                local position = a:Lerp(b, distance / length)\n                position = Vector3.new(position.X, target.Y - 2.75, position.Z)\n                local cf = CFrame.lookAt(position, position + direction.Unit)\n                count += 1\n                draw(count, cf * CFrame.new(0, 0, 0.6), Vector3.new(0.2, 0.12, 1.4))\n                for _, side in ipairs({-1, 1}) do\n                    count += 1\n                    draw(count, cf * CFrame.new(side * 0.4, 0, 0) * CFrame.Angles(0, side * math.pi / 4, 0),\n                        Vector3.new(0.22, 0.12, 1.25))\n                end\n                distance += spacing\n            end\n            carry = distance - length\n        end\n    end)\nend\n\nreturn Guide\n"},{Parent="ReplicatedStorage.Shared",Name="TableButter",Class="ModuleScript",Source="local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal Interaction = require(script.Parent.ButterInteraction)\nlocal TableButter = {}\nlocal active\n\nlocal function place(source, tablePart, name, sizeLimit)\n    local clone = source:Clone()\n    local model = clone\n    if clone:IsA(\"BasePart\") then\n        model = Instance.new(\"Model\")\n        clone.Parent = model\n    end\n    model.Name = name\n    for _, item in ipairs(model:GetDescendants()) do\n        if item:IsA(\"LuaSourceContainer\") or item:IsA(\"ProximityPrompt\") then item:Destroy()\n        elseif item:IsA(\"BasePart\") then\n            item.Anchored = true\n            item.CanCollide, item.CanTouch, item.CanQuery = false, false, true\n        end\n    end\n    local size = model:GetExtentsSize()\n    model:ScaleTo(model:GetScale() * sizeLimit / math.max(size.X, size.Y, size.Z, 0.01))\n    model:PivotTo(tablePart.CFrame.Rotation * model:GetPivot().Rotation)\n    local box, bounds = model:GetBoundingBox()\n    local top = tablePart.CFrame:PointToWorldSpace(Vector3.new(0, tablePart.Size.Y / 2 + bounds.Y / 2 + 0.18, 0))\n    model:PivotTo(CFrame.new(top - box.Position) * model:GetPivot())\n    model.Parent = workspace\n    return model\nend\n\nfunction TableButter.Start(tablePart, butterId, config, remote, applyResponse)\n    if active then return false, \"Finish your current butter first.\" end\n    local sources = ReplicatedStorage:FindFirstChild(\"ButterModels\")\n    local source = sources and (sources:FindFirstChild(butterId) or sources:FindFirstChild(config.Name))\n    if not source then return false, \"That butter model is missing from ButterModels.\" end\n    local model = place(source, tablePart, \"LocalTableButter\", math.min(4, tablePart.Size.X * 0.7))\n    local effect = Interaction.new(model, workspace, nil, workspace.CurrentCamera)\n    local session = {Model = model, Connections = {}, Effect = effect}\n    active = session\n    local originalPrompt = tablePart:FindFirstChild(\"KitchenCrackPrompt\")\n    if originalPrompt then originalPrompt.Enabled = false end\n    local function close()\n        if active ~= session then return end\n        active = nil\n        for _, connection in ipairs(session.Connections) do connection:Disconnect() end\n        if session.Effect then session.Effect:Destroy() end\n        if session.Model then session.Model:Destroy() end\n        if originalPrompt and originalPrompt.Parent then originalPrompt.Enabled = true end\n    end\n    local stage, busy = 0, false\n    local function hit(result)\n        if busy or active ~= session then return end\n        busy = true\n        stage += 1\n        effect:Hit(result, stage)\n        if stage < 3 then task.delay(0.3, function() busy = false end) return end\n        task.delay(0.6, function()\n            if active ~= session then return end\n            local ok, response = pcall(function() return remote:InvokeServer(butterId) end)\n            if ok then applyResponse(response) else applyResponse({Message = \"Unable to crack butter. Try again.\"}) end\n            if active ~= session then return end\n            if not ok or not response or not response.Ok then close() return end\n            effect:Destroy()\n            session.Effect = nil\n            model:Destroy()\n            local folder = ReplicatedStorage:FindFirstChild(\"BeebohModels\")\n            local prize = response.Prize\n            local sourcePrize = folder and (folder:FindFirstChild(prize.Id) or folder:FindFirstChild(prize.Name))\n            local fallback\n            if not sourcePrize then\n                fallback = Instance.new(\"Part\")\n                fallback.Shape = Enum.PartType.Ball\n                fallback.Color = Color3.fromRGB(106, 199, 239)\n                sourcePrize = fallback\n            end\n            session.Model = place(sourcePrize, tablePart, \"LocalTablePrize\", 1.8)\n            if fallback then fallback:Destroy() end\n            local sparkles = Instance.new(\"Sparkles\")\n            sparkles.SparkleColor = Color3.fromRGB(255, 221, 102)\n            sparkles.Parent = session.Model:FindFirstChildWhichIsA(\"BasePart\", true)\n            task.delay(3, close)\n        end)\n    end\n    table.insert(session.Connections, UserInputService.InputBegan:Connect(function(input, processed)\n        if processed or busy then return end\n        if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then\n            local p = model:FindFirstChildWhichIsA(\"BasePart\", true)\n            if p then hit({Instance = p, Position = p.Position, Normal = Vector3.yAxis}) end\n            return\n        end\n        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end\n        local inset = GuiService:GetGuiInset()\n        local ray = workspace.CurrentCamera:ViewportPointToRay(input.Position.X - inset.X, input.Position.Y - inset.Y)\n        local params = RaycastParams.new()\n        params.FilterType = Enum.RaycastFilterType.Include\n        params.FilterDescendantsInstances = {model}\n        local result = workspace:Raycast(ray.Origin, ray.Direction * 100, params)\n        if result then hit(result) end\n    end))\n    table.insert(session.Connections, RunService.Heartbeat:Connect(function()\n        local character = Players.LocalPlayer.Character\n        local root = character and character:FindFirstChild(\"HumanoidRootPart\")\n        local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n        if not tablePart.Parent or not root or not humanoid or humanoid.Health <= 0\n            or (root.Position - tablePart.Position).Magnitude > 14 then close() end\n    end))\n    return true\nend\n\nreturn TableButter\n"},{Parent="ReplicatedStorage.Shared",Name="ButterInteraction",Class="ModuleScript",Source="local RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal ButterInteraction = {}\nButterInteraction.__index = ButterInteraction\nlocal DENT_DURATION = 0.9\n\nfunction ButterInteraction.new(model, world, viewport, camera)\n\tlocal self = setmetatable({\n\t\tmodel = model, world = world, viewport = viewport, camera = camera,\n\t\tchips = {}, bones = {}, pulses = {}, broken = {}, groups = {},\n\t}, ButterInteraction)\n\tlocal _, size = model:GetBoundingBox()\n\tself.radius = math.max(size.X, size.Y, size.Z) * 0.19\n\tself.depth = math.min(size.X, size.Y, size.Z) * 0.24\n\tfor _, item in ipairs(model:GetDescendants()) do\n\t\tif item:IsA(\"BasePart\") then\n\t\t\titem.CanQuery = true\n\t\t\tif string.match(item.Name, \"^WaxChip_\") then\n\t\t\t\ttable.insert(self.chips, item)\n\t\t\t\tlocal group = string.match(item.Name, \"^(WaxChip_%d+)\")\n\t\t\t\tif group and (not self.groups[group] or string.find(item.Name, \"wrapper\")) then\n\t\t\t\t\tself.groups[group] = item.CFrame\n\t\t\t\tend\n\t\t\tend\n\t\telseif item:IsA(\"Bone\") and string.match(item.Name, \"^Dent_\") then\n\t\t\ttable.insert(self.bones, item)\n\t\tend\n\tend\n\tif #self.bones == 0 then\n\t\twarn(\"[ButterInteraction] No Dent_ bones found. Import the prepared FBX with Rig Type set to Custom; wrapper pieces alone cannot deform the butter.\")\n\telse\n\t\tprint(string.format(\"[ButterInteraction] Ready: %d dent bones, %d wrapper pieces\", #self.bones, #self.chips))\n\tend\n\tself.connection = RunService.RenderStepped:Connect(function()\n\t\tlocal now = os.clock()\n\t\tfor index = #self.pulses, 1, -1 do\n\t\t\tif now - self.pulses[index].time > DENT_DURATION then\n\t\t\t\ttable.remove(self.pulses, index)\n\t\t\tend\n\t\tend\n\t\tfor _, bone in ipairs(self.bones) do\n\t\t\tlocal displacement = Vector3.zero\n\t\t\tfor _, pulse in ipairs(self.pulses) do\n\t\t\t\tlocal weight = pulse.weights[bone] or 0\n\t\t\t\tlocal age = now - pulse.time\n\t\t\t\t-- Hold the dent while the opaque wrapper pieces move away.\n\t\t\t\tlocal attack = math.sin(math.pi * math.clamp(age / 0.12, 0, 1) / 2)\n\t\t\t\tlocal release = 1 - math.clamp((age - 0.42) / (DENT_DURATION - 0.42), 0, 1)\n\t\t\t\tdisplacement -= pulse.normal * self.depth * weight * attack * release * release\n\t\t\tend\n\t\t\tif displacement.Magnitude > self.depth then\n\t\t\t\tdisplacement = displacement.Unit * self.depth\n\t\t\tend\n\t\t\tbone.Transform = CFrame.new(bone.WorldCFrame:VectorToObjectSpace(displacement))\n\t\tend\n\tend)\n\treturn self\nend\n\nfunction ButterInteraction:Raycast(screenPosition)\n\tlocal size = self.viewport.AbsoluteSize\n\tlocal point = screenPosition - self.viewport.AbsolutePosition\n\tif size.X <= 0 or size.Y <= 0 or point.X < 0 or point.Y < 0 or point.X > size.X or point.Y > size.Y then\n\t\treturn nil\n\tend\n\t-- ViewportFrame cameras don't use the main window's viewport dimensions.\n\tlocal tangent = math.tan(math.rad(self.camera.FieldOfView) / 2)\n\tlocal direction = Vector3.new((2 * point.X / size.X - 1) * size.X / size.Y * tangent,\n\t\t(1 - 2 * point.Y / size.Y) * tangent, -1).Unit\n\tlocal params = RaycastParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Include\n\tparams.FilterDescendantsInstances = { self.model }\n\treturn self.world:Raycast(self.camera.CFrame.Position,\n\t\tself.camera.CFrame:VectorToWorldSpace(direction) * 1000, params)\nend\n\nfunction ButterInteraction:Hit(result, stage)\n\tlocal weights = {}\n\tlocal nearestSquared = math.huge\n\tfor _, bone in ipairs(self.bones) do\n\t\tlocal offset = bone.WorldCFrame.Position - result.Position\n\t\tlocal distanceSquared = offset:Dot(offset)\n\t\tweights[bone] = distanceSquared\n\t\tnearestSquared = math.min(nearestSquared, distanceSquared)\n\tend\n\t-- A sparse imported rig should still move at the nearest control point.\n\tfor bone, distanceSquared in pairs(weights) do\n\t\tweights[bone] = math.exp(-3 * (distanceSquared - nearestSquared) / self.radius ^ 2)\n\tend\n\ttable.insert(self.pulses, { weights = weights, normal = result.Normal, time = os.clock() })\n\tlocal nearestGroup = string.match(result.Instance.Name, \"^(WaxChip_%d+)\")\n\tfor _, chip in ipairs(self.chips) do\n\t\tlocal group = string.match(chip.Name, \"^(WaxChip_%d+)\")\n\t\tlocal origin = self.groups[group] or chip.CFrame\n\t\tlocal distance = (origin.Position - result.Position).Magnitude\n\t\tlocal sameGroup = nearestGroup and group == nearestGroup\n\t\tif not self.broken[chip] and (stage == 3 or sameGroup or distance < self.radius * 0.85) then\n\t\t\tself.broken[chip] = true\n\t\t\tchip.CanQuery = false\n\t\t\tlocal outward = origin.Position - result.Position\n\t\t\tif outward.Magnitude > 0.001 then\n\t\t\t\toutward = outward.Unit\n\t\t\telse\n\t\t\t\toutward = result.Normal\n\t\t\tend\n\t\t\tlocal target = origin + (result.Normal * 0.7 + outward * 0.5) * self.radius\n\t\t\ttarget *= CFrame.Angles(math.rad(25), math.rad(-18), math.rad(30))\n\t\t\ttarget *= origin:ToObjectSpace(chip.CFrame)\n\t\t\tTweenService:Create(chip, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {\n\t\t\t\tCFrame = target, Transparency = 1,\n\t\t\t}):Play()\n\t\tend\n\tend\nend\n\nfunction ButterInteraction:Destroy()\n\tself.connection:Disconnect()\n\tfor _, bone in ipairs(self.bones) do\n\t\tbone.Transform = CFrame.identity\n\tend\nend\n\nreturn ButterInteraction\n"},{Parent="ReplicatedStorage.Shared",Name="GroceryCombatConfig",Class="ModuleScript",Source="return {\n    PlayerDamage = 24,\n    PlayerAttackInterval = 0.45,\n    AttackRange = 6,\n    MaxDuration = 120,\n    Tiers = {\n        Plain = {Count = 2, Health = 24, Damage = 2, Speed = 11, AttackInterval = 1.8},\n        Salted = {Count = 2, Health = 32, Damage = 3, Speed = 12, AttackInterval = 1.8},\n        Golden = {Count = 3, Health = 40, Damage = 4, Speed = 13, AttackInterval = 1.8},\n        Rainbow = {Count = 3, Health = 48, Damage = 4, Speed = 14, AttackInterval = 1.7},\n        Cosmic = {Count = 4, Health = 56, Damage = 5, Speed = 15, AttackInterval = 1.6},\n    },\n}\n"},{Parent="ReplicatedStorage.Shared",Name="GroceryCombatClient",Class="ModuleScript",Source="local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal Config = require(script.Parent.GroceryCombatConfig)\nlocal Client = {}\n\nlocal function part(parent, name, size, color, offset)\n    local p = Instance.new(\"Part\")\n    p.Name = name\n    p.Size = size\n    p.Color = color\n    p.Anchored = true\n    p.CanCollide = false\n    p.CanTouch = false\n    p.CanQuery = false\n    p.Material = Enum.Material.Plastic\n    for _, face in ipairs({\"Top\", \"Bottom\", \"Left\", \"Right\", \"Front\", \"Back\"}) do\n        p[face .. \"Surface\"] = Enum.SurfaceType.Studs\n    end\n    p.Parent = parent\n    return {Part = p, Offset = offset or CFrame.identity}\nend\n\nlocal function officer(parent)\n    local model = Instance.new(\"Model\")\n    model.Name = \"PoliceOfficer\"\n    local blue, dark, skin = Color3.fromRGB(48, 102, 191), Color3.fromRGB(33, 38, 53), Color3.fromRGB(237, 191, 142)\n    local pieces = {}\n    local function add(name, size, color, x, y, z)\n        local piece = part(model, name, size, color, CFrame.new(x, y, z))\n        table.insert(pieces, piece)\n        return piece.Part\n    end\n    add(\"Uniform\", Vector3.new(2, 2, 1), blue, 0, 0, 0)\n    local head = add(\"Head\", Vector3.new(1.65, 1.65, 1.3), skin, 0, 1.8, 0)\n    add(\"Cap\", Vector3.new(1.9, 0.45, 1.6), blue, 0, 2.65, 0)\n    add(\"CapBrim\", Vector3.new(2, 0.15, 1), dark, 0, 2.4, -0.65)\n    add(\"Badge\", Vector3.new(0.35, 0.5, 0.12), Color3.fromRGB(255, 214, 65), -0.45, 0.45, -0.56)\n    add(\"Belt\", Vector3.new(2.1, 0.3, 1.1), dark, 0, -0.75, 0)\n    add(\"LeftArm\", Vector3.new(0.7, 1.9, 0.8), blue, -1.4, 0, 0)\n    add(\"RightArm\", Vector3.new(0.7, 1.9, 0.8), blue, 1.4, 0, 0)\n    add(\"LeftLeg\", Vector3.new(0.85, 1.8, 0.9), dark, -0.52, -1.8, 0)\n    add(\"RightLeg\", Vector3.new(0.85, 1.8, 0.9), dark, 0.52, -1.8, 0)\n    for _, x in ipairs({-0.32, 0.32}) do\n        add(\"Eye\", Vector3.new(0.15, 0.18, 0.08), dark, x, 1.9, -0.68)\n    end\n    local gui = Instance.new(\"BillboardGui\")\n    gui.Size = UDim2.fromOffset(70, 8)\n    gui.StudsOffset = Vector3.new(0, 1.7, 0)\n    gui.AlwaysOnTop = false\n    gui.Parent = head\n    local bg = Instance.new(\"Frame\")\n    bg.Size = UDim2.fromScale(1, 1)\n    bg.BackgroundColor3 = dark\n    bg.BorderSizePixel = 0\n    bg.Parent = gui\n    local health = bg:Clone()\n    health.BackgroundColor3 = Color3.fromRGB(91, 218, 142)\n    health.Parent = bg\n    model.Parent = parent\n    return {Model = model, Pieces = pieces, Health = health, Punch = 0, LastAttack = 0}\nend\n\nlocal function pose(rig, cf, phase, walking)\n    for _, piece in ipairs(rig.Pieces) do\n        local offset = piece.Offset\n        if piece.Part.Name == \"RightArm\" then\n            offset *= CFrame.Angles(-math.sin(rig.Punch * math.pi) * 1.7, 0, 0)\n        elseif walking and piece.Part.Name:find(\"Leg\") then\n            offset *= CFrame.Angles(math.sin(phase) * (piece.Part.Name == \"LeftLeg\" and 0.35 or -0.35), 0, 0)\n        end\n        piece.Part.CFrame = cf * offset\n    end\nend\n\nfunction Client.Start(remote)\n    local player = Players.LocalPlayer\n    local folder = Instance.new(\"Folder\")\n    folder.Name = \"LocalGroceryPolice\"\n    folder.Parent = Workspace\n    local active, rigs, gates, idle = nil, {}, nil, {}\n    local finished = {}\n    local idleStore, lastIdleCheck = nil, 0\n    local lastPlayerAttack, punchTime = 0, 0\n    local punchingJoint, originalC0\n    local gui = Instance.new(\"ScreenGui\")\n    gui.Name = \"GroceryCombatHUD\"\n    gui.ResetOnSpawn = false\n    gui.Parent = player:WaitForChild(\"PlayerGui\")\n    local status = Instance.new(\"TextLabel\")\n    status.AnchorPoint = Vector2.new(0.5, 0)\n    status.Position = UDim2.new(0.5, 0, 0, 72)\n    status.Size = UDim2.new(0.8, 0, 0, 50)\n    local constraint = Instance.new(\"UISizeConstraint\")\n    constraint.MaxSize = Vector2.new(360, 50)\n    constraint.Parent = status\n    status.BackgroundColor3 = Color3.fromRGB(31, 35, 43)\n    status.BackgroundTransparency = 0.15\n    status.TextColor3 = Color3.fromRGB(255, 241, 211)\n    status.Font = Enum.Font.GothamBold\n    status.TextSize = 17\n    status.TextWrapped = true\n    status.Visible = false\n    status.Parent = gui\n\n    local function clear()\n        if punchingJoint and punchingJoint.Parent then punchingJoint.C0 = originalC0 end\n        punchingJoint, originalC0, punchTime = nil, nil, 0\n        for _, rig in ipairs(rigs) do rig.Model:Destroy() end\n        rigs = {}\n        if gates then gates:Destroy() gates = nil end\n        active = nil\n        status.Visible = false\n    end\n    local function update(snapshot)\n        if not snapshot then\n            if active then finished[active.Id] = true end\n            clear()\n            return\n        end\n        if finished[snapshot.Id] then return end\n        if active and active.Id == snapshot.Id and snapshot.Time < active.Time then return end\n        if not active or active.Id ~= snapshot.Id then\n            clear()\n            gates = Instance.new(\"Folder\")\n            gates.Name = \"PersonalSectionGates\"\n            gates.Parent = folder\n            local height = snapshot.CeilingHeight or 20\n            for _, side in ipairs({-1, 1}) do\n                local cf = snapshot.Floor * CFrame.new(0, height / 2, side * (snapshot.Size.Z / 2 - 1))\n                local wall = part(gates, \"Barrier\", Vector3.new(snapshot.Size.X, height, 1), Color3.fromRGB(222, 87, 74)).Part\n                wall.CFrame = cf\n                wall.Transparency = 0.8\n                wall.CanCollide = true\n                for x = -snapshot.Size.X / 2, snapshot.Size.X / 2, 4 do\n                    local bar = part(gates, \"SecurityBar\", Vector3.new(0.5, height, 0.7), Color3.fromRGB(243, 186, 61)).Part\n                    bar.CFrame = cf * CFrame.new(x, 0, 0)\n                end\n            end\n        end\n        active = snapshot\n        local alive = 0\n        for i, data in ipairs(snapshot.Officers) do\n            if not rigs[i] then rigs[i] = officer(folder) rigs[i].Position = data.Position end\n            local rig = rigs[i]\n            rig.Model.Parent = data.Health > 0 and folder or nil\n            rig.Health.Size = UDim2.fromScale(math.clamp(data.Health / data.MaxHealth, 0, 1), 1)\n            if data.Attack ~= rig.LastAttack then rig.Punch = 1 rig.LastAttack = data.Attack end\n            if data.Health > 0 then alive += 1 end\n        end\n        if snapshot.PlayerAttack ~= lastPlayerAttack then\n            lastPlayerAttack = snapshot.PlayerAttack\n            punchTime = 0.25\n        end\n        status.Text = string.format(\"%s | %d officers\\nHealth %d / %d\", snapshot.Tier, alive,\n            math.ceil(snapshot.PlayerHealth), math.ceil(snapshot.PlayerMaxHealth))\n        status.Visible = true\n    end\n    remote.OnClientEvent:Connect(update)\n    RunService.RenderStepped:Connect(function(dt)\n        local now = os.clock()\n        if now - lastIdleCheck > 1 then\n            lastIdleCheck = now\n            local map = Workspace:FindFirstChild(\"SquishTheButterMap\")\n            local store = map and map:FindFirstChild(\"GroceryStore\")\n            if store ~= idleStore then\n                for _, entry in ipairs(idle) do entry.Rig.Model:Destroy() end\n                idle = {}\n                idleStore = store\n            end\n            if store and #idle == 0 then\n                for _, section in ipairs(store:GetChildren()) do\n                    local tier = section.Name:match(\"^Section%d+_(%a+)$\")\n                    local spec = tier and Config.Tiers[tier]\n                    local floor = section:FindFirstChild(\"OpenFloor\")\n                    if spec and floor then\n                        for i = 1, spec.Count do\n                            local rig = officer(folder)\n                            table.insert(idle, {Rig = rig, Tier = tier, CFrame = floor.CFrame *\n                                CFrame.new((i - (spec.Count + 1) / 2) * 7, floor.Size.Y / 2 + 3, 0)})\n                        end\n                    end\n                end\n            end\n        end\n        for _, entry in ipairs(idle) do\n            entry.Rig.Model.Parent = folder\n            if active and active.Tier == entry.Tier then entry.Rig.Model.Parent = nil end\n            pose(entry.Rig, entry.CFrame, 0, false)\n        end\n        local character = player.Character\n        local root = character and character:FindFirstChild(\"HumanoidRootPart\")\n        if active and root then\n            for i, rig in ipairs(rigs) do\n                local target = active.Officers[i].Position\n                local moving = (target - rig.Position).Magnitude > 0.05\n                rig.Position = rig.Position:Lerp(target, math.min(1, dt * 15))\n                local look = Vector3.new(root.Position.X, rig.Position.Y, root.Position.Z)\n                local cf = (look - rig.Position).Magnitude > 0.05 and CFrame.lookAt(rig.Position, look) or CFrame.new(rig.Position)\n                rig.Punch = math.max(0, rig.Punch - dt * 4)\n                pose(rig, cf, now * 9, moving)\n            end\n        end\n        if punchTime > 0 and character then\n            punchTime = math.max(0, punchTime - dt)\n            local shoulder = character:FindFirstChild(\"RightShoulder\", true) or character:FindFirstChild(\"Right Shoulder\", true)\n            if shoulder and shoulder:IsA(\"Motor6D\") then\n                if punchingJoint ~= shoulder then\n                    if punchingJoint and punchingJoint.Parent then punchingJoint.C0 = originalC0 end\n                    punchingJoint, originalC0 = shoulder, shoulder.C0\n                end\n                shoulder.C0 = originalC0 * CFrame.Angles(-math.sin(punchTime / 0.25 * math.pi) * 1.3, 0, 0)\n            end\n        elseif punchingJoint then\n            if punchingJoint.Parent then punchingJoint.C0 = originalC0 end\n            punchingJoint, originalC0 = nil, nil\n        end\n    end)\n    return update\nend\n\nreturn Client\n"},{Parent="ReplicatedStorage.Shared",Name="GroceryPickupClient",Class="ModuleScript",Source="local Workspace = game:GetService(\"Workspace\")\nlocal ProximityPromptService = game:GetService(\"ProximityPromptService\")\n\nlocal Client = {}\n\nfunction Client.Start(remote, applyResponse)\n    local claims = {}\n    local pending = {}\n    local pendingPickup\n    local originals = setmetatable({}, {__mode = \"k\"})\n    local updateCombat = require(script.Parent.GroceryCombatClient).Start(remote.Parent:WaitForChild(\"GroceryCombatState\"))\n    local function hideIfClaimed(object)\n        local model = object\n        while model and model ~= Workspace do\n            local id = model:GetAttribute(\"GroceryPickupId\")\n            if id then\n                do\n                    local hidden = claims[id] or pendingPickup == id\n                    local function hide(child)\n                        if child:IsA(\"BasePart\") then child.LocalTransparencyModifier = hidden and 1 or 0\n                        elseif child:IsA(\"Decal\") then\n                            if originals[child] == nil then originals[child] = child.Transparency end\n                            child.Transparency = hidden and 1 or originals[child]\n                        elseif child:IsA(\"ProximityPrompt\") then\n                            child.Enabled = not hidden and pendingPickup == nil\n                        elseif child:IsA(\"SurfaceGui\") or child:IsA(\"BillboardGui\") or child:IsA(\"ParticleEmitter\")\n                            or child:IsA(\"Trail\") or child:IsA(\"Beam\") then\n                            if originals[child] == nil then originals[child] = child.Enabled end\n                            child.Enabled = not hidden and originals[child]\n                        end\n                    end\n                    hide(model)\n                    for _, child in ipairs(model:GetDescendants()) do hide(child) end\n                end\n                return\n            end\n            model = model.Parent\n        end\n    end\n    Workspace.DescendantAdded:Connect(function(object)\n        task.defer(hideIfClaimed, object)\n    end)\n    ProximityPromptService.PromptTriggered:Connect(function(prompt)\n        if prompt.Name ~= \"GroceryPickupPrompt\" then return end\n        local model = prompt:FindFirstAncestorOfClass(\"Model\")\n        local id = model and model:GetAttribute(\"GroceryPickupId\")\n        if not id or claims[id] or pending[id] or pendingPickup then return end\n        pending[id] = true\n        local ok, result = pcall(function() return remote:InvokeServer(id) end)\n        pending[id] = nil\n        if ok and result then\n            applyResponse(result)\n        end\n    end)\n    return function(state)\n        claims = {}\n        pendingPickup = state.GroceryEncounter and state.GroceryEncounter.PickupId or nil\n        updateCombat(state.GroceryEncounter)\n        for id, claimed in pairs(state.GroceryClaims or {}) do\n            if claimed then claims[id] = true end\n        end\n        local map = Workspace:FindFirstChild(\"SquishTheButterMap\")\n        local store = map and map:FindFirstChild(\"GroceryStore\")\n        local folder = store and store:FindFirstChild(\"PickupDisplays\")\n        if folder then\n            for _, model in ipairs(folder:GetChildren()) do hideIfClaimed(model) end\n        end\n    end\nend\n\nreturn Client\n"},{Parent="StarterPlayer.StarterPlayerScripts",Name="Client",Class="LocalScript",Source="local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService