assert(not game:GetService("RunService"):IsRunning(), "Stop Play first!") local map = workspace:FindFirstChild("SquishTheButterMap") local store = map and map:FindFirstChild("GroceryStore") assert(store, "GroceryStore is missing.") local models = game.ReplicatedStorage:FindFirstChild("ButterModels") assert(models, "Put your actual butter models in ReplicatedStorage.ButterModels first.") local editor = game:GetService("ScriptEditorService") local edits = {{Parent="ServerScriptService",Name="Server",Class="Script",Source="local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal DataStoreService = game:GetService(\"DataStoreService\")\nlocal TextService = game:GetService(\"TextService\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal Debris = game:GetService(\"Debris\")\n\nlocal GameConfig = require(ReplicatedStorage.Shared.GameConfig)\n\nlocal DATA_STORE_NAME = \"SquishTheButter_PlayerData_v1\"\nlocal AUTOSAVE_SECONDS = 60\nlocal COIN_TICK_SECONDS = 1\nlocal PRIZE_DESPAWN_SECONDS = 20\nlocal MAX_BEEBOHS = 20\nlocal MAX_EQUIPPED_BEEBOHS = 3\nlocal ADMIN_USER_IDS = {\n\t-- Add your Roblox UserId here if game.CreatorId does not match in Studio.\n\t-- Example: [123456789] = true,\n\t[96528615] = true,\n}\n\nlocal dataStore = DataStoreService:GetDataStore(DATA_STORE_NAME)\nlocal playerData = {}\n\nlocal remotesFolder = ReplicatedStorage:FindFirstChild(\"ButterRemotes\")\nif not remotesFolder then\n\tremotesFolder = Instance.new(\"Folder\")\n\tremotesFolder.Name = \"ButterRemotes\"\n\tremotesFolder.Parent = ReplicatedStorage\nend\n\nlocal function getOrCreateRemote(name)\n\tlocal remote = remotesFolder:FindFirstChild(name)\n\tif not remote then\n\t\tremote = Instance.new(\"RemoteFunction\")\n\t\tremote.Name = name\n\t\tremote.Parent = remotesFolder\n\tend\n\n\treturn remote\nend\n\nlocal function getOrCreateRemoteEvent(name)\n\tlocal remote = remotesFolder:FindFirstChild(name)\n\tif not remote then\n\t\tremote = Instance.new(\"RemoteEvent\")\n\t\tremote.Name = name\n\t\tremote.Parent = remotesFolder\n\tend\n\n\treturn remote\nend\n\nlocal GetState = getOrCreateRemote(\"GetState\")\nlocal BuyButter = getOrCreateRemote(\"BuyButter\")\nlocal CrackButter = getOrCreateRemote(\"CrackButter\")\nlocal DeleteBeeboh = getOrCreateRemote(\"DeleteBeeboh\")\nlocal RenameBeeboh = getOrCreateRemote(\"RenameBeeboh\")\nlocal ToggleEquipBeeboh = getOrCreateRemote(\"ToggleEquipBeeboh\")\nlocal PrizeRevealed = getOrCreateRemoteEvent(\"PrizeRevealed\")\nlocal PickupButter = getOrCreateRemote(\"PickupButter\")\nlocal GroceryCombatState = getOrCreateRemoteEvent(\"GroceryCombatState\")\nlocal ToggleKitchenBeeboh = getOrCreateRemote(\"ToggleKitchenBeeboh\")\nlocal OpenKitchenCrack = getOrCreateRemoteEvent(\"OpenKitchenCrack\")\nlocal CrackKitchenButter = getOrCreateRemote(\"CrackKitchenButter\")\nlocal tableCrackTimes = {}\nlocal kitchens\nlocal kitchenRequestTimes = {}\nlocal groceryCombat\nlocal groceryEntries = {}\nlocal groceryRequestTimes = {}\n\nlocal stationDebounces = {}\nlocal followerModels = {}\nlocal updateLeaderstats\nlocal rebuildFollowerModels\n\nlocal function makeDefaultData()\n\treturn {\n\t\tCoins = 0,\n\t\tButter = {\n\t\t\tPlain = 1,\n\t\t},\n\t\tBeebohs = {},\n\t\tEquippedBeebohs = {},\n\t\tCollection = {},\n\t\tGroceryClaims = {},\n\t\tKitchenBeebohs = {},\n\t}\nend\n\nlocal function copyArray(array)\n\tlocal result = {}\n\n\tfor index, value in ipairs(array or {}) do\n\t\tresult[index] = if typeof(value) == \"table\" then table.clone(value) else value\n\tend\n\n\treturn result\nend\n\nlocal function cleanBeebohName(name, fallback)\n\tlocal cleaned = tostring(name or fallback or \"Beeboh\")\n\tcleaned = string.gsub(cleaned, \"^%s+\", \"\")\n\tcleaned = string.gsub(cleaned, \"%s+$\", \"\")\n\tcleaned = string.sub(cleaned, 1, 24)\n\n\tif cleaned == \"\" then\n\t\treturn fallback or \"Beeboh\"\n\tend\n\n\treturn cleaned\nend\n\nlocal function filterBeebohNameForPlayer(player, name, fallback)\n\tlocal cleaned = cleanBeebohName(name, fallback)\n\tlocal success, result = pcall(function()\n\t\tlocal filterResult = TextService:FilterStringAsync(cleaned, player.UserId)\n\t\treturn filterResult:GetNonChatStringForBroadcastAsync()\n\tend)\n\n\tif success then\n\t\treturn cleanBeebohName(result, fallback)\n\tend\n\n\treturn cleaned\nend\n\nlocal function getBeebohId(entry)\n\tif typeof(entry) == \"table\" then\n\t\treturn entry.Id\n\tend\n\n\treturn entry\nend\n\nlocal function makeBeebohEntry(beebohId, customName)\n\tlocal beeboh = GameConfig.Beebohs[beebohId]\n\tif not beeboh then\n\t\treturn nil\n\tend\n\n\treturn {\n\t\tId = beebohId,\n\t\tName = cleanBeebohName(customName, beeboh.Name),\n\t}\nend\n\nlocal function isAdminPlayer(player)\n\tif ADMIN_USER_IDS[player.UserId] then\n\t\treturn true\n\tend\n\n\treturn game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId\nend\n\nlocal function normalizeCommandText(text)\n\treturn string.lower(string.gsub(tostring(text or \"\"), \"%s+\", \"\"))\nend\n\nlocal function findBeebohIdFromCommand(text)\n\tlocal normalized = normalizeCommandText(text)\n\n\tfor beebohId, beeboh in pairs(GameConfig.Beebohs) do\n\t\tif normalizeCommandText(beebohId) == normalized or normalizeCommandText(beeboh.Name) == normalized then\n\t\t\treturn beebohId\n\t\tend\n\tend\n\n\treturn nil\nend\n\nlocal function giveBeebohForTesting(player, beebohId, amount)\n\tlocal data = playerData[player]\n\tlocal beeboh = GameConfig.Beebohs[beebohId]\n\n\tif not data or not beeboh then\n\t\treturn false\n\tend\n\n\tlocal added = 0\n\tlocal count = math.clamp(math.floor(tonumber(amount) or 1), 1, MAX_BEEBOHS)\n\n\tfor _ = 1, count do\n\t\tif #data.Beebohs >= MAX_BEEBOHS then\n\t\t\tbreak\n\t\tend\n\n\t\ttable.insert(data.Beebohs, makeBeebohEntry(beebohId))\n\t\tdata.Collection[beebohId] = true\n\t\tadded += 1\n\tend\n\n\tif added > 0 then\n\t\tupdateLeaderstats(player)\n\t\trebuildFollowerModels(player)\n\t\tprint(`Admin gave {player.Name} {added}x {beeboh.Name}.`)\n\tend\n\n\treturn added > 0\nend\n\nlocal function giveButterForTesting(player, butterId, amount)\n\tlocal data = playerData[player]\n\tlocal butter = GameConfig.Butter[butterId]\n\n\tif not data or not butter then\n\t\treturn false\n\tend\n\n\tlocal count = math.max(1, math.floor(tonumber(amount) or 1))\n\n\tdata.Butter[butterId] = (data.Butter[butterId] or 0) + count\n\n\tupdateLeaderstats(player)\n\n\tprint(`Admin gave {player.Name} {count}x {butter.Name}.`)\n\n\treturn true\nend\n\nlocal function findButterIdFromCommand(text)\n\tlocal normalized = normalizeCommandText(text)\n\n\tfor butterId, butter in pairs(GameConfig.Butter) do\n\t\tif normalizeCommandText(butterId) == normalized\n\t\t\tor normalizeCommandText(butter.Name) == normalized then\n\t\t\treturn butterId\n\t\tend\n\tend\n\n\treturn nil\nend\n\nlocal function handleAdminCommand(player, message)\n\tif not isAdminPlayer(player) then\n\t\treturn\n\tend\n\n\tlocal parts = string.split(message, \" \")\n\tlocal command = string.lower(parts[1] or \"\")\n\n\t-- Give Beeboh\n\tif command == \"!givebeeboh\"\n\t\tor command == \"/givebeeboh\"\n\t\tor command == \"!beeboh\" then\n\n\t\tlocal requestedId = parts[2]\n\n\t\tif not requestedId then\n\t\t\twarn(\"Use: !givebeeboh BeebohId amount\")\n\t\t\treturn\n\t\tend\n\n\t\tlocal beebohId = findBeebohIdFromCommand(requestedId)\n\n\t\tif not beebohId then\n\t\t\twarn(`Unknown Beeboh id \"{requestedId}\".`)\n\t\t\treturn\n\t\tend\n\n\t\tgiveBeebohForTesting(player, beebohId, parts[3])\n\t\treturn\n\tend\n\n\t-- Give Butter\n\tif command == \"!givebutter\"\n\t\tor command == \"/givebutter\"\n\t\tor command == \"!butter\" then\n\n\t\tlocal requestedId = parts[2]\n\n\t\tif not requestedId then\n\t\t\twarn(\"Use: !givebutter ButterId amount\")\n\t\t\treturn\n\t\tend\n\n\t\tlocal butterId = findButterIdFromCommand(requestedId)\n\n\t\tif not butterId then\n\t\t\twarn(`Unknown Butter id \"{requestedId}\".`)\n\t\t\treturn\n\t\tend\n\n\t\tgiveButterForTesting(player, butterId, parts[3])\n\tend\nend\n\nlocal function isEquipped(data, index)\n\tfor _, equippedIndex in ipairs(data.EquippedBeebohs) do\n\t\tif equippedIndex == index then\n\t\t\treturn true\n\t\tend\n\tend\n\n\treturn false\nend\n\nlocal function sanitizeEquippedBeebohs(data)\n\tlocal clean = {}\n\tlocal seen = {}\n\n\tfor _, rawIndex in ipairs(data.EquippedBeebohs or {}) do\n\t\tlocal index = math.floor(tonumber(rawIndex) or 0)\n\t\tif index >= 1 and index <= #data.Beebohs and not seen[index] and #clean < MAX_EQUIPPED_BEEBOHS then\n\t\t\ttable.insert(clean, index)\n\t\t\tseen[index] = true\n\t\tend\n\tend\n\n\tdata.EquippedBeebohs = clean\nend\n\nlocal function sanitizeData(data)\n\tlocal clean = makeDefaultData()\n\n\tif typeof(data) ~= \"table\" then\n\t\treturn clean\n\tend\n\n\tclean.Coins = math.max(0, math.floor(tonumber(data.Coins) or 0))\n\tif typeof(data.GroceryClaims) == \"table\" then\n\t\tfor id, claimed in pairs(data.GroceryClaims) do\n\t\t\tif typeof(id) == \"string\" and #id < 80 and id:match(\"^GroceryV1_%a+_%d+$\") and claimed == true then\n\t\t\t\tclean.GroceryClaims[id] = true\n\t\t\tend\n\t\tend\n\tend\n\n\tif typeof(data.Butter) == \"table\" then\n\t\tfor butterId in pairs(GameConfig.Butter) do\n\t\t\tlocal amount = math.max(0, math.floor(tonumber(data.Butter[butterId]) or 0))\n\t\t\tif amount > 0 then\n\t\t\t\tclean.Butter[butterId] = amount\n\t\t\tend\n\t\tend\n\tend\n\n\tlocal savedBeebohs = data.Beebohs\n\tif typeof(savedBeebohs) == \"table\" then\n\t\tfor _, entry in ipairs(savedBeebohs) do\n\t\t\tlocal beebohId = getBeebohId(entry)\n\t\t\tif GameConfig.Beebohs[beebohId] then\n\t\t\t\tlocal customName = if typeof(entry) == \"table\" then entry.Name else nil\n\t\t\t\ttable.insert(clean.Beebohs, makeBeebohEntry(beebohId, customName))\n\t\t\t\tclean.Collection[beebohId] = true\n\t\t\tend\n\t\tend\n\tend\n\n\tif typeof(data.EquippedBeebohs) == \"table\" then\n\t\tfor _, index in ipairs(data.EquippedBeebohs) do\n\t\t\ttable.insert(clean.EquippedBeebohs, index)\n\t\tend\n\tend\n\n\tsanitizeEquippedBeebohs(clean)\n\tif typeof(data.KitchenBeebohs) == \"table\" then\n\t\tfor _, index in ipairs(data.KitchenBeebohs) do\n\t\t\tif typeof(index) == \"number\" and index == math.floor(index) and index >= 1 and index <= #clean.Beebohs\n\t\t\t\tand not table.find(clean.KitchenBeebohs, index) and not table.find(clean.EquippedBeebohs, index) then\n\t\t\t\ttable.insert(clean.KitchenBeebohs, index)\n\t\t\tend\n\t\tend\n\tend\n\n\tif typeof(data.Collection) == \"table\" then\n\t\tfor beebohId, owned in pairs(data.Collection) do\n\t\t\tif owned and GameConfig.Beebohs[beebohId] then\n\t\t\t\tclean.Collection[beebohId] = true\n\t\t\tend\n\t\tend\n\tend\n\n\treturn clean\nend\n\nlocal function getCoinRate(data)\n\tlocal rate = 0\n\n\tfor _, entry in ipairs(data.Beebohs) do\n\t\tlocal beebohId = getBeebohId(entry)\n\t\tlocal beeboh = GameConfig.Beebohs[beebohId]\n\t\tif beeboh then\n\t\t\trate += beeboh.CoinsPerSecond\n\t\tend\n\tend\n\n\treturn rate\nend\n\nlocal function makePublicState(player)\n\tlocal data = playerData[player]\n\tif not data then\n\t\treturn nil\n\tend\n\n\treturn {\n\t\tCoins = data.Coins,\n\t\tCoinRate = getCoinRate(data),\n\t\tButter = table.clone(data.Butter),\n\t\tBeebohs = copyArray(data.Beebohs),\n\t\tEquippedBeebohs = copyArray(data.EquippedBeebohs),\n\t\tCollection = table.clone(data.Collection),\n\t\tGroceryClaims = table.clone(data.GroceryClaims),\n\t\tKitchenBeebohs = table.clone(data.KitchenBeebohs),\n\t\tKitchenPlot = kitchens and kitchens.Assignments[player] and kitchens.Assignments[player].Name or nil,\n\t\tGroceryEncounter = groceryCombat and groceryCombat:Snapshot(player) or nil,\n\t\tButterConfig = GameConfig.Butter,\n\t\tBeebohConfig = GameConfig.Beebohs,\n\t\tRarityConfig = GameConfig.Rarities,\n\t\tMaxBeebohs = MAX_BEEBOHS,\n\t\tMaxEquippedBeebohs = MAX_EQUIPPED_BEEBOHS,\n\t}\nend\n\nupdateLeaderstats = function(player)\n\tlocal data = playerData[player]\n\tif not data then\n\t\treturn\n\tend\n\n\tlocal leaderstats = player:FindFirstChild(\"leaderstats\")\n\tif not leaderstats then\n\t\treturn\n\tend\n\n\tlocal coins = leaderstats:FindFirstChild(\"Coins\")\n\tlocal rate = leaderstats:FindFirstChild(\"CoinsPerSecond\")\n\n\tif coins then\n\t\tcoins.Value = data.Coins\n\tend\n\n\tif rate then\n\t\trate.Value = getCoinRate(data)\n\tend\nend\n\nlocal function savePlayer(player)\n\tlocal data = playerData[player]\n\tif not data then\n\t\treturn\n\tend\n\n\tlocal key = `Player_{player.UserId}`\n\tlocal success, err = pcall(function()\n\t\tdataStore:SetAsync(key, data)\n\tend)\n\n\tif not success then\n\t\twarn(`Failed to save data for {player.Name}: {err}`)\n\tend\nend\n\nlocal function loadPlayer(player)\n\tlocal key = `Player_{player.UserId}`\n\tlocal loadedData = nil\n\n\tlocal success, err = pcall(function()\n\t\tloadedData = dataStore:GetAsync(key)\n\tend)\n\n\tif not success then\n\t\twarn(`Failed to load data for {player.Name}: {err}`)\n\tend\n\n\tplayerData[player] = sanitizeData(loadedData)\nend\n\nlocal function makeLeaderstats(player)\n\tlocal leaderstats = Instance.new(\"Folder\")\n\tleaderstats.Name = \"leaderstats\"\n\tleaderstats.Parent = player\n\n\tlocal coins = Instance.new(\"IntValue\")\n\tcoins.Name = \"Coins\"\n\tcoins.Parent = leaderstats\n\n\tlocal rate = Instance.new(\"IntValue\")\n\trate.Name = \"CoinsPerSecond\"\n\trate.Parent = leaderstats\n\n\tupdateLeaderstats(player)\nend\n\nlocal function pickRarity(butterConfig)\n\tlocal totalWeight = 0\n\n\tfor rarityId, weight in pairs(butterConfig.Odds) do\n\t\tif GameConfig.Rarities[rarityId] then\n\t\t\ttotalWeight += weight\n\t\tend\n\tend\n\n\tlocal roll = math.random() * totalWeight\n\tlocal running = 0\n\n\tfor rarityId, weight in pairs(butterConfig.Odds) do\n\t\tif GameConfig.Rarities[rarityId] then\n\t\t\trunning += weight\n\t\t\tif roll <= running then\n\t\t\t\treturn rarityId\n\t\t\tend\n\t\tend\n\tend\n\n\treturn \"Common\"\nend\n\nlocal function pickBeeboh(rarityId)\n\tlocal candidates = {}\n\n\tfor beebohId, beeboh in pairs(GameConfig.Beebohs) do\n\t\tif beeboh.Rarity == rarityId then\n\t\t\ttable.insert(candidates, beebohId)\n\t\tend\n\tend\n\n\tif #candidates == 0 then\n\t\treturn \"BlueBlob\"\n\tend\n\n\treturn candidates[math.random(1, #candidates)]\nend\n\nlocal function getStationPart(station)\n\tif station:IsA(\"BasePart\") then\n\t\treturn station\n\tend\n\n\tif station:IsA(\"Model\") then\n\t\tif station.PrimaryPart then\n\t\t\treturn station.PrimaryPart\n\t\tend\n\n\t\treturn station:FindFirstChildWhichIsA(\"BasePart\", true)\n\tend\n\n\treturn nil\nend\n\nlocal function getStationCFrame(station)\n\tif station:IsA(\"Model\") then\n\t\treturn station:GetPivot()\n\tend\n\n\tif station:IsA(\"BasePart\") then\n\t\treturn station.CFrame\n\tend\n\n\treturn CFrame.new()\nend\n\nlocal function findBeebohModel(prize)\n\tlocal beebohModels = ReplicatedStorage:FindFirstChild(\"BeebohModels\")\n\tif not beebohModels then\n\t\treturn nil\n\tend\n\n\tlocal sourceModel = beebohModels:FindFirstChild(prize.Id) or beebohModels:FindFirstChild(prize.Name)\n\tif sourceModel and (sourceModel:IsA(\"Model\") or sourceModel:IsA(\"BasePart\")) then\n\t\treturn sourceModel\n\tend\n\n\treturn nil\nend\n\nlocal function preparePrizeModel(sourceModel, spawnCFrame)\n\tlocal clone = sourceModel:Clone()\n\tclone.Name = \"PrizeModel\"\n\n\tlocal model\n\tif clone:IsA(\"BasePart\") then\n\t\tmodel = Instance.new(\"Model\")\n\t\tmodel.Name = \"PrizeModel\"\n\t\tclone.Parent = model\n\t\tmodel.PrimaryPart = clone\n\telse\n\t\tmodel = clone\n\t\tif not model.PrimaryPart then\n\t\t\tmodel.PrimaryPart = model:FindFirstChildWhichIsA(\"BasePart\", true)\n\t\tend\n\tend\n\n\tif not model.PrimaryPart then\n\t\tmodel:Destroy()\n\t\treturn nil\n\tend\n\n\tmodel.Parent = Workspace\n\tmodel:PivotTo(spawnCFrame)\n\n\tfor _, descendant in ipairs(model:GetDescendants()) do\n\t\tif descendant:IsA(\"BasePart\") then\n\t\t\tdescendant.Anchored = false\n\t\t\tdescendant.CanCollide = true\n\t\telseif descendant:IsA(\"Script\") or descendant:IsA(\"LocalScript\") or descendant:IsA(\"ProximityPrompt\") then\n\t\t\tdescendant:Destroy()\n\t\tend\n\tend\n\n\treturn model\nend\n\nlocal function prepareFollowerModel(sourceModel, parent, fallbackColor)\n\tlocal model = nil\n\n\tif sourceModel then\n\t\tlocal clone = sourceModel:Clone()\n\t\tclone.Name = \"FollowerBeeboh\"\n\n\t\tif clone:IsA(\"BasePart\") then\n\t\t\tmodel = Instance.new(\"Model\")\n\t\t\tmodel.Name = \"FollowerBeeboh\"\n\t\t\tclone.Parent = model\n\t\t\tmodel.PrimaryPart = clone\n\t\telse\n\t\t\tmodel = clone\n\t\t\tif not model.PrimaryPart then\n\t\t\t\tmodel.PrimaryPart = model:FindFirstChildWhichIsA(\"BasePart\", true)\n\t\t\tend\n\t\tend\n\tend\n\n\tif not model then\n\t\tlocal ball = Instance.new(\"Part\")\n\t\tball.Name = \"FollowerBeeboh\"\n\t\tball.Anchored = true\n\t\tball.Shape = Enum.PartType.Ball\n\t\tball.Material = Enum.Material.SmoothPlastic\n\t\tball.Color = fallbackColor or Color3.fromRGB(126, 220, 255)\n\t\tball.Size = Vector3.new(1.8, 1.8, 1.8)\n\n\t\tmodel = Instance.new(\"Model\")\n\t\tmodel.Name = \"FollowerBeeboh\"\n\t\tball.Parent = model\n\t\tmodel.PrimaryPart = ball\n\tend\n\n\tif not model.PrimaryPart then\n\t\tmodel:Destroy()\n\t\treturn nil\n\tend\n\n\tmodel.Parent = parent\n\n\tfor _, descendant in ipairs(model:GetDescendants()) do\n\t\tif descendant:IsA(\"BasePart\") then\n\t\t\tdescendant.Anchored = true\n\t\t\tdescendant.CanCollide = false\n\t\t\tdescendant.CanTouch = false\n\t\t\tdescendant.CanQuery = false\n\t\telseif descendant:IsA(\"Script\") or descendant:IsA(\"LocalScript\") or descendant:IsA(\"ProximityPrompt\") then\n\t\t\tdescendant:Destroy()\n\t\tend\n\tend\n\n\treturn model\nend\n\nlocal function clearFollowerModels(player)\n\tlocal models = followerModels[player]\n\tif models then\n\t\tfor _, model in ipairs(models) do\n\t\t\tmodel:Destroy()\n\t\tend\n\tend\n\n\tfollowerModels[player] = {}\n\n\tlocal character = player.Character\n\tlocal oldFolder = character and character:FindFirstChild(\"EquippedBeebohFollowers\")\n\tif oldFolder then\n\t\toldFolder:Destroy()\n\tend\nend\n\nrebuildFollowerModels = function(player)\n\tlocal data = playerData[player]\n\tif not data then\n\t\treturn\n\tend\n\n\tsanitizeEquippedBeebohs(data)\n\tclearFollowerModels(player)\n\n\tlocal character = player.Character\n\tif not character then\n\t\treturn\n\tend\n\n\tlocal folder = Instance.new(\"Folder\")\n\tfolder.Name = \"EquippedBeebohFollowers\"\n\tfolder.Parent = character\n\n\tlocal models = {}\n\tfor slot, beebohIndex in ipairs(data.EquippedBeebohs) do\n\t\tlocal entry = data.Beebohs[beebohIndex]\n\t\tlocal beebohId = getBeebohId(entry)\n\t\tlocal beeboh = GameConfig.Beebohs[beebohId]\n\n\t\tif beeboh then\n\t\t\tlocal sourceModel = findBeebohModel({\n\t\t\t\tId = beebohId,\n\t\t\t\tName = beeboh.Name,\n\t\t\t})\n\t\t\tlocal model = prepareFollowerModel(sourceModel, folder, beeboh.Color)\n\n\t\t\tif model then\n\t\t\t\tmodel:SetAttribute(\"FollowerSlot\", slot)\n\t\t\t\tmodel:SetAttribute(\"BeebohIndex\", beebohIndex)\n\t\t\t\ttable.insert(models, model)\n\t\t\tend\n\t\tend\n\tend\n\n\tfollowerModels[player] = models\nend\n\nlocal function createPrizeDrop(player, station, prize)\n\tlocal rarity = GameConfig.Rarities[prize.Rarity]\n\tlocal spawnCFrame = getStationCFrame(station) * CFrame.new(0, 3, -4)\n\tlocal sourceModel = findBeebohModel(prize)\n\tlocal prizeModel = if sourceModel then preparePrizeModel(sourceModel, spawnCFrame) else nil\n\tlocal labelPart = nil\n\n\tif prizeModel then\n\t\tprizeModel.Name = `{player.Name}_{prize.Id}_Prize`\n\t\tlabelPart = prizeModel.PrimaryPart\n\telse\n\t\tlocal ball = Instance.new(\"Part\")\n\t\tball.Name = `{player.Name}_{prize.Id}_Prize`\n\t\tball.Shape = Enum.PartType.Ball\n\t\tball.Size = Vector3.new(2.2, 2.2, 2.2)\n\t\tball.Material = Enum.Material.SmoothPlastic\n\t\tball.Color = if rarity then rarity.Color else Color3.fromRGB(255, 255, 255)\n\t\tball.CFrame = spawnCFrame\n\t\tball.Anchored = false\n\t\tball.CanCollide = true\n\t\tball.Parent = Workspace\n\t\tlabelPart = ball\n\tend\n\n\tlocal attachment = Instance.new(\"Attachment\")\n\tattachment.Position = Vector3.new(0, 1.6, 0)\n\tattachment.Parent = labelPart\n\n\tlocal label = Instance.new(\"BillboardGui\")\n\tlabel.Name = \"PrizeLabel\"\n\tlabel.AlwaysOnTop = true\n\tlabel.Size = UDim2.fromOffset(180, 56)\n\tlabel.StudsOffset = Vector3.new(0, 1.5, 0)\n\tlabel.Parent = attachment\n\n\tlocal text = Instance.new(\"TextLabel\")\n\ttext.BackgroundTransparency = 1\n\ttext.Font = Enum.Font.GothamBlack\n\ttext.Text = `{prize.Name}\\n+{prize.CoinsPerSecond}/sec`\n\ttext.TextColor3 = if rarity then rarity.Color else Color3.fromRGB(255, 255, 255)\n\ttext.TextSize = 14\n\ttext.TextStrokeTransparency = 0.25\n\ttext.TextWrapped = true\n\ttext.Size = UDim2.fromScale(1, 1)\n\ttext.Parent = label\n\n\tlocal impulse = Vector3.new(math.random(-18, 18), math.random(32, 42), math.random(-18, 18))\n\tlabelPart:ApplyImpulse(impulse * labelPart.AssemblyMass)\n\n\tDebris:AddItem(if prizeModel then prizeModel else labelPart, PRIZE_DESPAWN_SECONDS)\nend\n\nlocal function crackButterForPlayer(player, butterId, station)\n\tlocal data = playerData[player]\n\tlocal butterConfig = GameConfig.Butter[butterId]\n\n\tif not data or not butterConfig then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = \"That butter stick does not exist.\",\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tif (data.Butter[butterId] or 0) <= 0 then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = \"You do not own that butter stick.\",\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tif #data.Beebohs >= MAX_BEEBOHS then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = `Your Beeboh inventory is full ({MAX_BEEBOHS}/{MAX_BEEBOHS}). Delete one before cracking more butter.`,\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tdata.Butter[butterId] -= 1\n\n\tlocal rarityId = pickRarity(butterConfig)\n\tlocal beebohId = pickBeeboh(rarityId)\n\tlocal beeboh = GameConfig.Beebohs[beebohId]\n\n\ttable.insert(data.Beebohs, makeBeebohEntry(beebohId))\n\tdata.Collection[beebohId] = true\n\n\tupdateLeaderstats(player)\n\trebuildFollowerModels(player)\n\n\tlocal prize = {\n\t\tId = beebohId,\n\t\tName = beeboh.Name,\n\t\tRarity = beeboh.Rarity,\n\t\tCoinsPerSecond = beeboh.CoinsPerSecond,\n\t}\n\n\tlocal result = {\n\t\tOk = true,\n\t\tMessage = `Cracked {butterConfig.Name} and found {beeboh.Name}!`,\n\t\tPrize = prize,\n\t\tState = makePublicState(player),\n\t}\n\n\tif station then\n\t\tcreatePrizeDrop(player, station, prize)\n\t\tPrizeRevealed:FireClient(player, result)\n\tend\n\n\treturn result\nend\n\nlocal function setupButterStation(station)\n\tif station:FindFirstAncestor(\"PickupDisplays\") then return end\n\tif station:GetAttribute(\"ButterStationReady\") then\n\t\treturn\n\tend\n\n\tif station.Name ~= \"ButterStick\" and station.Name ~= \"ButterStation\" and not station:GetAttribute(\"ButterId\") then\n\t\treturn\n\tend\n\n\tlocal stationPart = getStationPart(station)\n\tif not stationPart then\n\t\twarn(`Butter station {station:GetFullName()} needs at least one BasePart.`)\n\t\treturn\n\tend\n\n\tstation:SetAttribute(\"ButterStationReady\", true)\n\n\tlocal butterId = station:GetAttribute(\"ButterId\") or \"Plain\"\n\tif not GameConfig.Butter[butterId] then\n\t\twarn(`Butter station {station:GetFullName()} has invalid ButterId \"{butterId}\". Falling back to Plain.`)\n\t\tbutterId = \"Plain\"\n\tend\n\n\tlocal prompt = stationPart:FindFirstChild(\"CrackButterPrompt\")\n\tif not prompt then\n\t\tprompt = Instance.new(\"ProximityPrompt\")\n\t\tprompt.Name = \"CrackButterPrompt\"\n\t\tprompt.Parent = stationPart\n\tend\n\n\tprompt.ActionText = \"Crack\"\n\tprompt.ObjectText = GameConfig.Butter[butterId].Name\n\tprompt.HoldDuration = 0.5\n\tprompt.MaxActivationDistance = 12\n\tprompt.RequiresLineOfSight = false\n\n\tprompt.Triggered:Connect(function(player)\n\t\tlocal key = `{player.UserId}:{station:GetFullName()}`\n\t\tif stationDebounces[key] then\n\t\t\treturn\n\t\tend\n\n\t\tstationDebounces[key] = true\n\t\tlocal result = crackButterForPlayer(player, butterId, station)\n\n\t\tif not result.Ok then\n\t\t\twarn(`{player.Name}: {result.Message}`)\n\t\tend\n\n\t\ttask.delay(1, function()\n\t\t\tstationDebounces[key] = nil\n\t\tend)\n\tend)\nend\n\nlocal function setupExistingButterStations()\n\tfor _, descendant in ipairs(Workspace:GetDescendants()) do\n\t\tsetupButterStation(descendant)\n\tend\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n\tloadPlayer(player)\n\tmakeLeaderstats(player)\n\tif kitchens and player.Parent == Players then kitchens:Assign(player) end\n\n\tplayer.Chatted:Connect(function(message)\n\t\thandleAdminCommand(player, message)\n\tend)\n\n\tplayer.CharacterAdded:Connect(function()\n\t\ttask.defer(rebuildFollowerModels, player)\n\tend)\n\n\tif player.Character then\n\t\ttask.defer(rebuildFollowerModels, player)\n\tend\nend)\n\nPlayers.PlayerRemoving:Connect(function(player)\n\tif kitchens then kitchens:Release(player) end\n\tclearFollowerModels(player)\n\tsavePlayer(player)\n\tplayerData[player] = nil\n\tgroceryRequestTimes[player] = nil\n\tkitchenRequestTimes[player] = nil\n\ttableCrackTimes[player] = nil\n\tfollowerModels[player] = nil\nend)\n\nGetState.OnServerInvoke = function(player)\n\treturn {\n\t\tOk = true,\n\t\tState = makePublicState(player),\n\t}\nend\n\nPickupButter.OnServerInvoke = function(player, pickupId)\n\tlocal now = os.clock()\n\tif now - (groceryRequestTimes[player] or -math.huge) < 0.2 then return {Ok = false} end\n\tgroceryRequestTimes[player] = now\n\tlocal data = playerData[player]\n\tlocal entry = typeof(pickupId) == \"string\" and groceryEntries[pickupId]\n\tif not data or not entry or not entry.Model:IsDescendantOf(Workspace) then return {Ok = false} end\n\tif data.GroceryClaims[pickupId] then\n\t\treturn {Ok = false, State = makePublicState(player)}\n\tend\n\tlocal character = player.Character\n\tlocal root = character and character:FindFirstChild(\"HumanoidRootPart\")\n\tlocal humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n\tif not root or not humanoid or humanoid.Health <= 0 or (root.Position - entry.Anchor.Position).Magnitude > 14 then\n\t\treturn {Ok = false, Message = \"Move closer to pick up the butter.\"}\n\tend\n\tif not groceryCombat then return {Ok = false, Message = \"The officers are not ready yet.\"} end\n\tlocal started, reason = groceryCombat:Start(player, pickupId, entry)\n\treturn {Ok = started, Message = reason or \"Defeat the officers to escape with your butter!\", State = makePublicState(player)}\nend\n\nBuyButter.OnServerInvoke = function(player, butterId)\n\tlocal data = playerData[player]\n\tlocal butterConfig = GameConfig.Butter[butterId]\n\n\tif not data or not butterConfig then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = \"That butter stick does not exist.\",\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tif data.Coins < butterConfig.Cost then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = \"Not enough coins.\",\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tdata.Coins -= butterConfig.Cost\n\tdata.Butter[butterId] = (data.Butter[butterId] or 0) + 1\n\n\tupdateLeaderstats(player)\n\n\treturn {\n\t\tOk = true,\n\t\tMessage = `Bought {butterConfig.Name}.`,\n\t\tState = makePublicState(player),\n\t}\nend\n\nCrackButter.OnServerInvoke = function(player, butterId)\n\treturn crackButterForPlayer(player, butterId, nil)\nend\n\nCrackKitchenButter.OnServerInvoke = function(player, butterId)\n\tlocal plot = kitchens and kitchens.Assignments[player]\n\tlocal kitchen = plot and plot:FindFirstChild(\"StarterKitchen\")\n\tlocal tablePart = kitchen and kitchen:FindFirstChild(\"CrackingTable\")\n\tlocal character = player.Character\n\tlocal root = character and character:FindFirstChild(\"HumanoidRootPart\")\n\tlocal humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n\tif typeof(butterId) ~= \"string\" or not tablePart or not root or not humanoid or humanoid.Health <= 0\n\t\tor (root.Position - tablePart.Position).Magnitude > 12 or (groceryCombat and groceryCombat.Active[player]) then\n\t\treturn {Ok = false, Message = \"Use your own kitchen table while nearby and out of combat.\"}\n\tend\n\tlocal now = os.clock()\n\tif now - (tableCrackTimes[player] or -math.huge) < 1 then return {Ok = false} end\n\ttableCrackTimes[player] = now\n\treturn crackButterForPlayer(player, butterId, nil)\nend\n\nDeleteBeeboh.OnServerInvoke = function(player, beebohIndex)\n\tlocal data = playerData[player]\n\tlocal index = math.floor(tonumber(beebohIndex) or 0)\n\n\tif not data then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = \"Your data is not loaded yet.\",\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tif index < 1 or index > #data.Beebohs then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = \"That Beeboh is no longer in your inventory.\",\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tlocal removedEntry = table.remove(data.Beebohs, index)\n\tlocal removedId = getBeebohId(removedEntry)\n\tlocal removed = GameConfig.Beebohs[removedId]\n\tlocal nextEquipped = {}\n\n\tfor _, equippedIndex in ipairs(data.EquippedBeebohs) do\n\t\tif equippedIndex < index then\n\t\t\ttable.insert(nextEquipped, equippedIndex)\n\t\telseif equippedIndex > index then\n\t\t\ttable.insert(nextEquipped, equippedIndex - 1)\n\t\tend\n\tend\n\n\tdata.EquippedBeebohs = nextEquipped\n\tlocal nextKitchen = {}\n\tfor _, placedIndex in ipairs(data.KitchenBeebohs) do\n\t\tif placedIndex < index then table.insert(nextKitchen, placedIndex)\n\t\telseif placedIndex > index then table.insert(nextKitchen, placedIndex - 1) end\n\tend\n\tdata.KitchenBeebohs = nextKitchen\n\tif kitchens then kitchens:Rebuild(player) end\n\n\tupdateLeaderstats(player)\n\trebuildFollowerModels(player)\n\n\treturn {\n\t\tOk = true,\n\t\tMessage = if removed then `Deleted {removed.Name}.` else \"Deleted Beeboh.\",\n\t\tState = makePublicState(player),\n\t}\nend\n\nToggleEquipBeeboh.OnServerInvoke = function(player, beebohIndex)\n\tlocal data = playerData[player]\n\tlocal index = math.floor(tonumber(beebohIndex) or 0)\n\n\tif not data then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = \"Your data is not loaded yet.\",\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tif index < 1 or index > #data.Beebohs then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = \"That Beeboh is no longer in your inventory.\",\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tsanitizeEquippedBeebohs(data)\n\n\tfor equippedSlot, equippedIndex in ipairs(data.EquippedBeebohs) do\n\t\tif equippedIndex == index then\n\t\t\ttable.remove(data.EquippedBeebohs, equippedSlot)\n\t\t\trebuildFollowerModels(player)\n\t\t\treturn {\n\t\t\t\tOk = true,\n\t\t\t\tMessage = \"Unequipped Beeboh.\",\n\t\t\t\tState = makePublicState(player),\n\t\t\t}\n\t\tend\n\tend\n\n\tif #data.EquippedBeebohs >= MAX_EQUIPPED_BEEBOHS then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = `You can only equip {MAX_EQUIPPED_BEEBOHS} Beebohs at a time.`,\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\ttable.insert(data.EquippedBeebohs, index)\n\tlocal kitchenSlot = table.find(data.KitchenBeebohs, index)\n\tif kitchenSlot then\n\t\ttable.remove(data.KitchenBeebohs, kitchenSlot)\n\t\tif kitchens then kitchens:Rebuild(player) end\n\tend\n\trebuildFollowerModels(player)\n\n\treturn {\n\t\tOk = true,\n\t\tMessage = \"Equipped Beeboh.\",\n\t\tState = makePublicState(player),\n\t}\nend\n\nToggleKitchenBeeboh.OnServerInvoke = function(player, index)\n\tlocal now = os.clock()\n\tif now - (kitchenRequestTimes[player] or -math.huge) < 0.25 then return {Ok = false} end\n\tkitchenRequestTimes[player] = now\n\tlocal data = playerData[player]\n\tif not data or typeof(index) ~= \"number\" or index ~= math.floor(index) or index < 1 or index > #data.Beebohs then\n\t\treturn {Ok = false, Message = \"That Beeboh is no longer available.\", State = makePublicState(player)}\n\tend\n\tlocal slot = table.find(data.KitchenBeebohs, index)\n\tif slot then\n\t\ttable.remove(data.KitchenBeebohs, slot)\n\telse\n\t\tif not kitchens or not kitchens:Assign(player) then\n\t\t\treturn {Ok = false, Message = \"All eight kitchens are occupied. A plot will be assigned when one is free.\", State = makePublicState(player)}\n\t\tend\n\t\ttable.insert(data.KitchenBeebohs, index)\n\t\tlocal equipped = table.find(data.EquippedBeebohs, index)\n\t\tif equipped then table.remove(data.EquippedBeebohs, equipped) end\n\tend\n\tif kitchens then kitchens:Rebuild(player) end\n\trebuildFollowerModels(player)\n\treturn {Ok = true, Message = slot and \"Returned Beeboh to inventory.\" or \"Beeboh placed in your kitchen.\", State = makePublicState(player)}\nend\n\nRenameBeeboh.OnServerInvoke = function(player, beebohIndex, newName)\n\tlocal data = playerData[player]\n\tlocal index = math.floor(tonumber(beebohIndex) or 0)\n\n\tif not data then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = \"Your data is not loaded yet.\",\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tif index < 1 or index > #data.Beebohs then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = \"That Beeboh is no longer in your inventory.\",\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tlocal entry = data.Beebohs[index]\n\tlocal beebohId = getBeebohId(entry)\n\tlocal beeboh = GameConfig.Beebohs[beebohId]\n\n\tif not beeboh then\n\t\treturn {\n\t\t\tOk = false,\n\t\t\tMessage = \"That Beeboh type does not exist.\",\n\t\t\tState = makePublicState(player),\n\t\t}\n\tend\n\n\tif typeof(entry) ~= \"table\" then\n\t\tentry = makeBeebohEntry(beebohId)\n\t\tdata.Beebohs[index] = entry\n\tend\n\n\tentry.Name = filterBeebohNameForPlayer(player, newName, beeboh.Name)\n\tif kitchens then kitchens:Rebuild(player) end\n\n\treturn {\n\t\tOk = true,\n\t\tMessage = `Renamed Beeboh to {entry.Name}.`,\n\t\tState = makePublicState(player),\n\t}\nend\n\ndo\n\tgroceryCombat = require(script.GroceryCombat).new(GroceryCombatState, function(player, pickupId, butterId, won, reason)\n\t\tlocal data = playerData[player]\n\t\tif not data then return end\n\t\tif won and not data.GroceryClaims[pickupId] then\n\t\t\tdata.GroceryClaims[pickupId] = true\n\t\t\tdata.Butter[butterId] = (data.Butter[butterId] or 0) + 1\n\t\tend\n\t\tPrizeRevealed:FireClient(player, {Ok = won, State = makePublicState(player),\n\t\t\tMessage = won and \"Officers defeated! Butter secured. You can return to your base.\"\n\t\t\t\tor \"Encounter ended (\" .. reason .. \"). The butter is available to retry.\"})\n\tend)\n\tlocal map = Workspace:FindFirstChild(\"SquishTheButterMap\")\n\tkitchens = require(script.Kitchens).new(map, playerData, function(entry, parent)\n\t\tlocal id = getBeebohId(entry)\n\t\tlocal config = GameConfig.Beebohs[id]\n\t\tif not config then return nil end\n\t\tlocal model = prepareFollowerModel(findBeebohModel({Id = id, Name = config.Name}), parent,\n\t\t\tGameConfig.Rarities[config.Rarity].Color)\n\t\tif model then model.Name = typeof(entry) == \"table\" and entry.Name or config.Name end\n\t\treturn model\n\tend, OpenKitchenCrack)\n\tlocal store = map and map:FindFirstChild(\"GroceryStore\")\n\tif store then\n\t\tgroceryEntries = require(script.GroceryPickups).Build(store)\n\tend\nend\nsetupExistingButterStations()\n\nWorkspace.DescendantAdded:Connect(function(descendant)\n\ttask.defer(setupButterStation, descendant)\nend)\n\nRunService.Heartbeat:Connect(function()\n\tfor player, models in pairs(followerModels) do\n\t\tlocal character = player.Character\n\t\tlocal rootPart = character and character:FindFirstChild(\"HumanoidRootPart\")\n\n\t\tif rootPart then\n\t\t\tfor slot, model in ipairs(models) do\n\t\t\t\tif model.Parent and model.PrimaryPart then\n\t\t\t\t\tlocal sideOffset = (slot - 2) * 2.1\n\t\t\t\t\tlocal bob = math.sin(os.clock() * 2.4 + slot) * 0.22\n\t\t\t\t\tlocal target = rootPart.CFrame * CFrame.new(sideOffset, 4.1 + bob, 4.2)\n\t\t\t\t\tmodel:PivotTo(target)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend)\n\ntask.spawn(function()\n\twhile true do\n\t\ttask.wait(COIN_TICK_SECONDS)\n\n\t\tfor player, data in pairs(playerData) do\n\t\t\tlocal coinRate = getCoinRate(data)\n\t\t\tif coinRate > 0 then\n\t\t\t\tdata.Coins += coinRate * COIN_TICK_SECONDS\n\t\t\t\tupdateLeaderstats(player)\n\t\t\tend\n\t\tend\n\tend\nend)\n\ntask.spawn(function()\n\twhile true do\n\t\ttask.wait(AUTOSAVE_SECONDS)\n\n\t\tfor player in pairs(playerData) do\n\t\t\tsavePlayer(player)\n\t\tend\n\tend\nend)\n\ngame:BindToClose(function()\n\tfor player in pairs(playerData) do\n\t\tsavePlayer(player)\n\tend\nend)\n"},{Parent="ServerScriptService.Server",Name="GroceryPickups",Class="ModuleScript",Source="local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal GroceryPickups = {}\nlocal TIERS = {\"Plain\", \"Salted\", \"Golden\", \"Rainbow\", \"Cosmic\"}\n\nfunction GroceryPickups.Build(store)\n    local sources = ReplicatedStorage:FindFirstChild(\"ButterModels\")\n    if not sources then\n        warn(\"Grocery pickups need ReplicatedStorage.ButterModels\")\n        return {}\n    end\n    local folder = store:FindFirstChild(\"PickupDisplays\")\n    if folder then folder:Destroy() end\n    folder = Instance.new(\"Folder\")\n    folder.Name = \"PickupDisplays\"\n    folder.Parent = store\n    local entries = {}\n    local markers = {}\n    for _, object in ipairs(store:GetDescendants()) do\n        if object:IsA(\"BasePart\") and object.Name == \"OversizedButter\" then\n            object.Transparency = 0\n            table.insert(markers, object)\n        end\n    end\n    local filter = {folder}\n    for _, marker in ipairs(markers) do table.insert(filter, marker) end\n    local rayParams = RaycastParams.new()\n    rayParams.FilterType = Enum.RaycastFilterType.Exclude\n    rayParams.FilterDescendantsInstances = filter\n    for index, tier in ipairs(TIERS) do\n        local section = store:FindFirstChild(string.format(\"Section%02d_%s\", index, tier))\n        local source = sources:FindFirstChild(tier) or sources:FindFirstChild(tier .. \" Butter\")\n        if not section or not source or not (source:IsA(\"Model\") or source:IsA(\"BasePart\")) then\n            warn(\"Missing grocery section or ButterModels model: \" .. tier)\n            continue\n        end\n        local tierMarkers = {}\n        for _, marker in ipairs(markers) do\n            if marker:IsDescendantOf(section) then table.insert(tierMarkers, marker) end\n        end\n        local floor = section:FindFirstChild(\"OpenFloor\")\n        if not floor or not floor:IsA(\"BasePart\") then\n            warn(\"Grocery section needs OpenFloor: \" .. tier)\n            continue\n        end\n        table.sort(tierMarkers, function(a, b)\n            local pa = floor.CFrame:PointToObjectSpace(a.Position)\n            local pb = floor.CFrame:PointToObjectSpace(b.Position)\n            if math.abs(pa.Z - pb.Z) > 0.01 then return pa.Z > pb.Z end\n            return pa.X < pb.X\n        end)\n        for slot, marker in ipairs(tierMarkers) do\n            local id = string.format(\"GroceryV1_%s_%02d\", tier, slot)\n            local model\n            if source:IsA(\"Model\") then\n                model = source:Clone()\n            else\n                model = Instance.new(\"Model\")\n                source:Clone().Parent = model\n            end\n            model.Name = id\n            -- Display copies must not carry scripts, crack prompts, or physics.\n            for _, object in ipairs(model:GetDescendants()) do\n                if object:IsA(\"LuaSourceContainer\") or object:IsA(\"ProximityPrompt\") or object:IsA(\"Light\") then\n                    object:Destroy()\n                elseif object:IsA(\"BasePart\") then\n                    object.Anchored = true\n                    object.CanCollide = false\n                    object.CanTouch = false\n                    object.CanQuery = false\n                    object:SetAttribute(\"ButterId\", nil)\n                    object:SetAttribute(\"ButterStationReady\", nil)\n                end\n            end\n            model:SetAttribute(\"ButterId\", nil)\n            local bounds = model:GetExtentsSize()\n            local longest = math.max(bounds.X, bounds.Y, bounds.Z)\n            if longest <= 0 then model:Destroy() continue end\n            local target = math.clamp(marker.Size.X * 0.55, 2, 7)\n            model:ScaleTo(model:GetScale() * target / longest)\n            model:PivotTo(marker.CFrame.Rotation * model:GetPivot().Rotation)\n            local box, size = model:GetBoundingBox()\n            local hit = Workspace:Raycast(marker.Position, Vector3.new(0, -300, 0), rayParams)\n            local bottom = hit and hit.Position.Y or (floor.Position.Y + floor.Size.Y / 2)\n            local center = Vector3.new(marker.Position.X, bottom + size.Y / 2 + 0.15, marker.Position.Z)\n            model:PivotTo(CFrame.new(center - box.Position) * model:GetPivot())\n            local anchor = Instance.new(\"Part\")\n            anchor.Name = \"PickupAnchor\"\n            anchor.Size = Vector3.new(0.2, 0.2, 0.2)\n            anchor.Transparency = 1\n            anchor.Anchored = true\n            anchor.CanCollide = false\n            anchor.CanTouch = false\n            anchor.CanQuery = false\n            anchor.CFrame = CFrame.new(center)\n            anchor.Parent = model\n            local prompt = Instance.new(\"ProximityPrompt\")\n            prompt.Name = \"GroceryPickupPrompt\"\n            prompt.ActionText = \"Pick up\"\n            prompt.ObjectText = tier .. \" Butter\"\n            prompt.HoldDuration = 0.25\n            prompt.MaxActivationDistance = 12\n            prompt.RequiresLineOfSight = false\n            prompt.Parent = anchor\n            model:SetAttribute(\"GroceryPickupId\", id)\n            model:SetAttribute(\"GroceryButterType\", tier)\n            model.Parent = folder\n            marker.Transparency = 1\n            marker.CanCollide = false\n            marker.CanTouch = false\n            marker.CanQuery = false\n            entries[id] = {Model = model, Anchor = anchor, ButterId = tier, Floor = floor}\n        end\n    end\n    return entries\nend\n\nreturn GroceryPickups\n"},{Parent="ServerScriptService.Server",Name="GroceryCombat",Class="ModuleScript",Source="local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal PathfindingService = game:GetService(\"PathfindingService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal Config = require(game.ReplicatedStorage.Shared.GroceryCombatConfig)\n\nlocal Combat = {}\nCombat.__index = Combat\n\nfunction Combat.new(remote, onFinish)\n    local self = setmetatable({Active = {}, Remote = remote, OnFinish = onFinish}, Combat)\n    local accumulated = 0\n    RunService.Heartbeat:Connect(function(dt)\n        accumulated += dt\n        if accumulated < 0.1 then return end\n        local elapsed = math.min(accumulated, 0.2)\n        accumulated = 0\n        for player, encounter in pairs(self.Active) do self:Step(player, encounter, elapsed) end\n    end)\n    Players.PlayerRemoving:Connect(function(player) self:Finish(player, false, \"Left\") end)\n    return self\nend\n\nfunction Combat:Snapshot(player)\n    local encounter = self.Active[player]\n    if not encounter then return nil end\n    local officers = {}\n    for i, officer in ipairs(encounter.Officers) do\n        officers[i] = {Position = officer.Position, Health = officer.Health, MaxHealth = encounter.Stats.Health,\n            Attack = officer.Attack or 0}\n    end\n    return {Id = encounter.Id, Time = os.clock(), PickupId = encounter.PickupId, Tier = encounter.Tier,\n        Floor = encounter.Floor.CFrame, Size = encounter.Floor.Size, Officers = officers,\n        CeilingHeight = encounter.CeilingHeight,\n        PlayerAttack = encounter.PlayerAttack or 0, PlayerHealth = encounter.Humanoid.Health,\n        PlayerMaxHealth = encounter.Humanoid.MaxHealth}\nend\n\nfunction Combat:Finish(player, won, reason)\n    local encounter = self.Active[player]\n    if not encounter then return end\n    self.Active[player] = nil\n    if encounter.Death then encounter.Death:Disconnect() end\n    if player.Parent == Players then\n        self.Remote:FireClient(player, false)\n        self.OnFinish(player, encounter.PickupId, encounter.ButterId, won, reason)\n    end\nend\n\nfunction Combat:Start(player, pickupId, entry)\n    if self.Active[player] then return false, \"Defeat the officers before grabbing more butter.\" end\n    local character = player.Character\n    local root = character and character:FindFirstChild(\"HumanoidRootPart\")\n    local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n    local floor = entry.Floor\n    local stats = Config.Tiers[entry.ButterId]\n    if not root or not humanoid or humanoid.Health <= 0 or not floor or not floor.Parent or not stats then\n        return false, \"This section is not ready for combat.\"\n    end\n    local localPosition = floor.CFrame:PointToObjectSpace(root.Position)\n    if math.abs(localPosition.X) > floor.Size.X / 2 or math.abs(localPosition.Z) > floor.Size.Z / 2 then\n        return false, \"Enter the section before picking up its butter.\"\n    end\n    local now = os.clock()\n    local ceiling = floor.Parent:FindFirstChild(\"Ceiling\")\n    local ceilingHeight = ceiling and (ceiling.Position.Y - floor.Position.Y - ceiling.Size.Y / 2) or 24\n    local encounter = {Id = game:GetService(\"HttpService\"):GenerateGUID(false), PickupId = pickupId,\n        ButterId = entry.ButterId, Tier = entry.ButterId, Floor = floor, Stats = stats,\n        Character = character, Humanoid = humanoid, Root = root, Started = now,\n        NextPlayerAttack = now + 0.5, Officers = {}, CeilingHeight = ceilingHeight}\n    for i = 1, stats.Count do\n        local offset = Vector3.new((i - (stats.Count + 1) / 2) * 7, floor.Size.Y / 2 + 3,\n            math.clamp(localPosition.Z - 18, -floor.Size.Z / 2 + 12, floor.Size.Z / 2 - 12))\n        encounter.Officers[i] = {Position = floor.CFrame:PointToWorldSpace(offset), Health = stats.Health,\n            NextAttack = now + 1 + i * 0.25, NextPath = 0, Path = {}, Waypoint = 1}\n    end\n    self.Active[player] = encounter\n    encounter.Death = humanoid.Died:Connect(function() self:Finish(player, false, \"Defeated\") end)\n    self.Remote:FireClient(player, self:Snapshot(player))\n    return true\nend\n\nlocal function visible(encounter, from, to)\n    local params = RaycastParams.new()\n    params.FilterType = Enum.RaycastFilterType.Exclude\n    local characters = {}\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player.Character then table.insert(characters, player.Character) end\n    end\n    params.FilterDescendantsInstances = characters\n    return Workspace:Raycast(from, to - from, params) == nil\nend\n\nfunction Combat:Navigate(player, encounter, officer, target, now, dt)\n    local delta = target - officer.Position\n    delta = Vector3.new(delta.X, 0, delta.Z)\n    if delta.Magnitude < 0.8 then return end\n    local destination\n    if visible(encounter, officer.Position, officer.Position + delta) then\n        destination = officer.Position + delta\n    else\n        if not officer.Computing and now >= officer.NextPath then\n            officer.Computing = true\n            officer.NextPath = now + 1\n            task.spawn(function()\n                local path = PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 5,\n                    AgentCanJump = false, WaypointSpacing = 4})\n                local ok = pcall(function() path:ComputeAsync(officer.Position, target) end)\n                if self.Active[player] ~= encounter or officer.Health <= 0 then return end\n                officer.Computing = false\n                if ok and path.Status == Enum.PathStatus.Success then\n                    officer.Path = path:GetWaypoints()\n                    officer.Waypoint = 2\n                end\n            end)\n        end\n        local waypoint = officer.Path[officer.Waypoint]\n        if waypoint then\n            destination = Vector3.new(waypoint.Position.X, officer.Position.Y, waypoint.Position.Z)\n            if (destination - officer.Position).Magnitude < 2 then\n                officer.Waypoint += 1\n            end\n        end\n    end\n    if destination then\n        local direction = destination - officer.Position\n        if direction.Magnitude > 0.1 then\n            local step = direction.Unit * math.min(direction.Magnitude, encounter.Stats.Speed * dt)\n            if visible(encounter, officer.Position, officer.Position + step) then\n                officer.Position += step\n            end\n        end\n    end\nend\n\nfunction Combat:Step(player, encounter, dt)\n    if player.Character ~= encounter.Character or not encounter.Root.Parent or encounter.Humanoid.Health <= 0\n        or not encounter.Floor:IsDescendantOf(Workspace) then\n        self:Finish(player, false, \"Reset\")\n        return\n    end\n    local now = os.clock()\n    if now - encounter.Started > Config.MaxDuration then\n        self:Finish(player, false, \"Timed out\")\n        return\n    end\n    -- Server bounds stop jumping over, walking around, or deleting personal gates.\n    local floor = encounter.Floor\n    local position = floor.CFrame:PointToObjectSpace(encounter.Root.Position)\n    local clamped = Vector3.new(math.clamp(position.X, -floor.Size.X / 2 + 2, floor.Size.X / 2 - 2),\n        math.clamp(position.Y, floor.Size.Y / 2 + 2, math.max(5, encounter.CeilingHeight - 2)),\n        math.clamp(position.Z, -floor.Size.Z / 2 + 3, floor.Size.Z / 2 - 3))\n    if (clamped - position).Magnitude > 0.1 then\n        encounter.Root.CFrame = CFrame.new(floor.CFrame:PointToWorldSpace(clamped)) * encounter.Root.CFrame.Rotation\n        encounter.Root.AssemblyLinearVelocity = Vector3.zero\n    end\n    local target = encounter.Root.Position\n    local nearest, nearestDistance = nil, Config.AttackRange\n    for i, officer in ipairs(encounter.Officers) do\n        if officer.Health > 0 then\n            local angle = (i - 1) * math.pi * 2 / #encounter.Officers\n            local pursuit = target + Vector3.new(math.cos(angle) * 3.5, 0, math.sin(angle) * 3.5)\n            self:Navigate(player, encounter, officer, pursuit, now, dt)\n            local guardPosition = floor.CFrame:PointToObjectSpace(officer.Position)\n            officer.Position = floor.CFrame:PointToWorldSpace(Vector3.new(\n                math.clamp(guardPosition.X, -floor.Size.X / 2 + 2, floor.Size.X / 2 - 2), guardPosition.Y,\n                math.clamp(guardPosition.Z, -floor.Size.Z / 2 + 3, floor.Size.Z / 2 - 3)))\n            local distance = (officer.Position - target).Magnitude\n            if distance <= nearestDistance and visible(encounter, officer.Position, target) then\n                nearest, nearestDistance = officer, distance\n            end\n        end\n    end\n    if nearest and now >= encounter.NextPlayerAttack then\n        encounter.NextPlayerAttack = now + Config.PlayerAttackInterval\n        nearest.Health = math.max(0, nearest.Health - Config.PlayerDamage)\n        encounter.PlayerAttack = now\n    end\n    local remaining = 0\n    for _, officer in ipairs(encounter.Officers) do\n        if officer.Health > 0 then\n            remaining += 1\n            if (officer.Position - target).Magnitude <= Config.AttackRange and now >= officer.NextAttack\n                and visible(encounter, officer.Position, target) then\n                officer.NextAttack = now + encounter.Stats.AttackInterval\n                officer.Attack = now\n                encounter.Humanoid:TakeDamage(encounter.Stats.Damage)\n                if encounter.Humanoid.Health <= 0 then self:Finish(player, false, \"Defeated\") return end\n            end\n        end\n    end\n    if remaining == 0 then self:Finish(player, true, \"Escaped\") return end\n    self.Remote:FireClient(player, self:Snapshot(player))\nend\n\nreturn Combat\n"},{Parent="ServerScriptService.Server",Name="Kitchens",Class="ModuleScript",Source="local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Layout = require(game.ReplicatedStorage.Shared.KitchenLayout)\nlocal Kitchens = {}\nKitchens.__index = Kitchens\n\nlocal function clearOwnerIndicator(plot)\n    local indicator = plot:FindFirstChild(\"PlotOwnerIndicator\")\n    if indicator then indicator:Destroy() end\nend\n\nlocal function showOwnerIndicator(plot, player)\n    clearOwnerIndicator(plot)\n    local area = plot.BuildArea\n    local height = area.Size.Y / 2 + 14\n    local kitchen = plot:FindFirstChild(\"StarterKitchen\")\n    if kitchen then\n        local box, size = kitchen:GetBoundingBox()\n        height = math.max(height, box.Position.Y + size.Y / 2 - area.Position.Y + 5)\n    end\n    local indicator = Instance.new(\"BillboardGui\")\n    indicator.Name = \"PlotOwnerIndicator\"\n    indicator.Adornee = area\n    indicator.Size = UDim2.fromScale(6, 6)\n    indicator.StudsOffsetWorldSpace = Vector3.new(0, height, 0)\n    indicator.AlwaysOnTop = true\n    indicator.MaxDistance = 300\n    indicator.Active = false\n    local head = Instance.new(\"ImageLabel\")\n    head.Name = \"OwnerHead\"\n    head.BackgroundTransparency = 1\n    head.Size = UDim2.fromScale(1, 1)\n    head.ScaleType = Enum.ScaleType.Fit\n    head.Image = string.format(\"rbxthumb://type=AvatarHeadShot&id=%d&w=420&h=420\", player.UserId)\n    head.Parent = indicator\n    indicator.Parent = plot\nend\n\nfunction Kitchens.new(map, data, createModel, openCracking)\n    local self = setmetatable({Assignments = {}, Roamers = {}, Data = data, CreateModel = createModel, Plots = {}}, Kitchens)\n    local plots = map and map:FindFirstChild(\"KitchenPlots\")\n    if plots then\n        for i = 1, 8 do\n            local plot = plots:FindFirstChild(string.format(\"Plot%02d\", i))\n            if plot and plot:FindFirstChild(\"BuildArea\") then\n                if not plot:FindFirstChild(\"StarterKitchen\") then Layout.Build(plot) end\n                if plot.StarterKitchen:GetAttribute(\"Stage\") == nil then\n                    plot.StarterKitchen:SetAttribute(\"Stage\", 1)\n                end\n                local oldBeebohs = plot:FindFirstChild(\"KitchenBeebohs\")\n                if oldBeebohs then oldBeebohs:Destroy() end\n                clearOwnerIndicator(plot)\n                plot:SetAttribute(\"OwnerUserId\", nil)\n                table.insert(self.Plots, plot)\n                local tablePart = plot.StarterKitchen:FindFirstChild(\"CrackingTable\")\n                if tablePart and openCracking then\n                    local prompt = tablePart:FindFirstChild(\"KitchenCrackPrompt\") or Instance.new(\"ProximityPrompt\")\n                    prompt.Name = \"KitchenCrackPrompt\"\n                    prompt.ActionText = \"Crack butter\"\n                    prompt.ObjectText = \"Kitchen table\"\n                    prompt.MaxActivationDistance = 10\n                    prompt.RequiresLineOfSight = false\n                    prompt.Parent = tablePart\n                    prompt.Triggered:Connect(function(player)\n                        local root = player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n                        local humanoid = player.Character and player.Character:FindFirstChildOfClass(\"Humanoid\")\n                        if self.Assignments[player] == plot and root and humanoid and humanoid.Health > 0\n                            and (root.Position - tablePart.Position).Magnitude <= 12 then\n                            openCracking:FireClient(player, tablePart)\n                        end\n                    end)\n                end\n            end\n        end\n    end\n    local elapsed, assignmentTimer = 0, 0\n    RunService.Heartbeat:Connect(function(dt)\n        elapsed += dt\n        assignmentTimer += dt\n        if assignmentTimer >= 1 then\n            assignmentTimer = 0\n            for _, player in ipairs(Players:GetPlayers()) do\n                if data[player] and not self.Assignments[player] then self:Assign(player) end\n            end\n        end\n        if elapsed < 0.1 then return end\n        self:Step(math.min(elapsed, 0.25))\n        elapsed = 0\n    end)\n    return self\nend\n\nlocal function ownerLabel(plot, text)\n    local sign = plot:FindFirstChild(\"PlotNumber\")\n    local label = sign and sign:FindFirstChildWhichIsA(\"TextLabel\", true)\n    if label then label.Text = text end\nend\n\nfunction Kitchens:Assign(player)\n    if self.Assignments[player] then return self.Assignments[player] end\n    for _, plot in ipairs(self.Plots) do\n        if plot.Parent and not plot:GetAttribute(\"OwnerUserId\") then\n            self.Assignments[player] = plot\n            player:SetAttribute(\"KitchenPlot\", plot.Name)\n            player:SetAttribute(\"KitchenVisited\", false)\n            local area = plot.BuildArea\n            player:SetAttribute(\"KitchenGuideTarget\", area.CFrame:PointToWorldSpace(\n                Vector3.new(0, area.Size.Y / 2 + 3, -area.Size.Z / 2 + 4)))\n            plot:SetAttribute(\"OwnerUserId\", player.UserId)\n            ownerLabel(plot, player.DisplayName)\n            showOwnerIndicator(plot, player)\n            self:Rebuild(player)\n            return plot\n        end\n    end\n    return nil\nend\n\nfunction Kitchens:ClearModels(player)\n    for _, item in ipairs(self.Roamers[player] or {}) do item.Model:Destroy() end\n    self.Roamers[player] = nil\n    local plot = self.Assignments[player]\n    local old = plot and plot:FindFirstChild(\"KitchenBeebohs\")\n    if old then old:Destroy() end\nend\n\nfunction Kitchens:Release(player)\n    self:ClearModels(player)\n    local plot = self.Assignments[player]\n    if plot and plot.Parent then\n        clearOwnerIndicator(plot)\n        plot:SetAttribute(\"OwnerUserId\", nil)\n        ownerLabel(plot, \"Available\")\n    end\n    self.Assignments[player] = nil\n    player:SetAttribute(\"KitchenPlot\", nil)\n    player:SetAttribute(\"KitchenGuideTarget\", nil)\n    player:SetAttribute(\"KitchenVisited\", nil)\nend\n\nfunction Kitchens:Rebuild(player)\n    self:ClearModels(player)\n    local plot = self.Assignments[player]\n    local data = self.Data[player]\n    local kitchen = plot and plot:FindFirstChild(\"StarterKitchen\")\n    local area = kitchen and kitchen:FindFirstChild(\"RoamArea\")\n    if not data or not area then return end\n    local folder = Instance.new(\"Folder\")\n    folder.Name = \"KitchenBeebohs\"\n    folder.Parent = plot\n    local roamers = {}\n    for _, index in ipairs(data.KitchenBeebohs) do\n        local entry = data.Beebohs[index]\n        if entry then\n            local model = self.CreateModel(entry, folder)\n            if model then\n                local extent = model:GetExtentsSize()\n                model:ScaleTo(model:GetScale() * 2 / math.max(extent.X, extent.Y, extent.Z, 0.01))\n                local box, size = model:GetBoundingBox()\n                local radius = math.sqrt(size.X * size.X + size.Z * size.Z) / 2\n                local halfX = math.max(0, area.Size.X / 2 - radius - 0.15)\n                local halfZ = math.max(0, area.Size.Z / 2 - radius - 0.15)\n                local random = Random.new(player.UserId % 100000 + index * 139)\n                local position = Vector3.new(random:NextNumber(-halfX, halfX), 0, random:NextNumber(-halfZ, halfZ))\n                table.insert(roamers, {Model = model, Area = area, Position = position, Target = position,\n                    HalfX = halfX, HalfZ = halfZ, Height = size.Y / 2 + 0.05,\n                    Offset = box:ToObjectSpace(model:GetPivot()), Random = random, Pause = 0, Yaw = 0})\n            end\n        end\n    end\n    self.Roamers[player] = roamers\n    self:Step(0)\nend\n\nfunction Kitchens:Step(dt)\n    for player, plot in pairs(self.Assignments) do\n        if not player:GetAttribute(\"KitchenVisited\") then\n            local root = player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n            local humanoid = player.Character and player.Character:FindFirstChildOfClass(\"Humanoid\")\n            local area = plot:FindFirstChild(\"BuildArea\")\n            if root and humanoid and humanoid.Health > 0 and area then\n                local point = area.CFrame:PointToObjectSpace(root.Position)\n                if math.abs(point.X) <= area.Size.X / 2 and math.abs(point.Z) <= area.Size.Z / 2\n                    and point.Y >= 0 and point.Y <= 12 then\n                    player:SetAttribute(\"KitchenVisited\", true)\n                end\n            end\n        end\n    end\n    for _, roamers in pairs(self.Roamers) do\n        for _, item in ipairs(roamers) do\n            if item.Model.Parent and item.Area.Parent then\n                local delta = item.Target - item.Position\n                if delta.Magnitude < 0.15 then\n                    item.Pause -= dt\n                    if item.Pause <= 0 then\n                        item.Target = Vector3.new(item.Random:NextNumber(-item.HalfX, item.HalfX), 0,\n                            item.Random:NextNumber(-item.HalfZ, item.HalfZ))\n                        item.Pause = item.Random:NextNumber(0.5, 2)\n                    end\n                else\n                    item.Position += delta.Unit * math.min(delta.Magnitude, dt * 2.2)\n                    item.Yaw = math.atan2(-delta.X, -delta.Z)\n                end\n                local cf = item.Area.CFrame * CFrame.new(item.Position.X, item.Height, item.Position.Z)\n                    * CFrame.Angles(0, item.Yaw, 0)\n                item.Model:PivotTo(cf * item.Offset)\n            end\n        end\n    end\nend\n\nreturn Kitchens\n"},{Parent="ReplicatedStorage.Shared",Name="KitchenTemplate",Class="ModuleScript",Source="-- Generated by tools/build_main_map.py from kitchen_structure.py.\r\nreturn game:GetService(\"HttpService\"):JSONDecode([==[[{\"name\":\"KitchenFloor\",\"position\":[-18,0.3,-12],\"size\":[44,0.6,38],\"color\":[207,220,222]},{\"name\":\"FloorTile\",\"position\":[-36,0.63,-27],\"size\":[7.8,0.06,7.8],\"color\":[229,236,232]},{\"name\":\"FloorTile\",\"position\":[-36,0.63,-11],\"size\":[7.8,0.06,7.8],\"color\":[229,236,232]},{\"name\":\"FloorTile\",\"position\":[-28,0.63,-19],\"size\":[7.8,0.06,7.8],\"color\":[229,236,232]},{\"name\":\"FloorTile\",\"position\":[-28,0.63,-3],\"size\":[7.8,0.06,7.8],\"color\":[229,236,232]},{\"name\":\"FloorTile\",\"position\":[-20,0.63,-27],\"size\":[7.8,0.06,7.8],\"color\":[229,236,232]},{\"name\":\"FloorTile\",\"position\":[-20,0.63,-11],\"size\":[7.8,0.06,7.8],\"color\":[229,236,232]},{\"name\":\"FloorTile\",\"position\":[-12,0.63,-19],\"size\":[7.8,0.06,7.8],\"color\":[229,236,232]},{\"name\":\"FloorTile\",\"position\":[-12,0.63,-3],\"size\":[7.8,0.06,7.8],\"color\":[229,236,232]},{\"name\":\"FloorTile\",\"position\":[-4,0.63,-27],\"size\":[7.8,0.06,7.8],\"color\":[229,236,232]},{\"name\":\"FloorTile\",\"position\":[-4,0.63,-11],\"size\":[7.8,0.06,7.8],\"color\":[229,236,232]},{\"name\":\"BackWall\",\"position\":[-18,9.6,6.5],\"size\":[44,18,1],\"color\":[240,245,240]},{\"name\":\"LeftWall\",\"position\":[-39.5,9.6,-12],\"size\":[1,18,38],\"color\":[240,245,240]},{\"name\":\"BackTrim\",\"position\":[-18,18.7,6.5],\"size\":[44,0.6,1.2],\"color\":[63,166,156]},{\"name\":\"LeftTrim\",\"position\":[-39.5,18.7,-12],\"size\":[1.2,0.6,38],\"color\":[63,166,156]},{\"name\":\"CounterCabinet\",\"position\":[-26,3.6,2],\"size\":[9,6,7],\"color\":[194